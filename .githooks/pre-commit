#!/bin/sh
# Formats and lints what is about to be committed.
#
# Only the two mechanical checks run here. Type checking and tests belong to
# `pnpm verify`: they take minutes, and a hook that slow gets bypassed until it
# may as well not exist.
#
# Files are read from the working tree rather than from the index, which matters
# for a file that is only partly staged. Such a file is never rewritten, because
# re-staging it would sweep in the parts deliberately left out of the commit, and
# it is checked as it sits on disk. That can fail a commit whose staged content
# is already clean; the alternative is skipping the file, which would let
# unformatted code through the one check meant to stop it.
#
# Bypass with `git commit --no-verify` when a commit has to land unfixed.
set -eu

# A closed stderr, as when the caller pipes git through `head`, would kill this
# hook with SIGPIPE mid-message, and git for Windows lets a commit through a hook
# killed that way. Ignoring the signal turns a failed write into an ordinary
# error, so the hook's own verdict is what sets its exit status.
trap "" PIPE

cd "$(git rev-parse --show-toplevel)"

work=$(mktemp -d)
report() {
  status=$?
  if [ "$status" -ne 0 ]; then
    printf '\npre-commit failed. Run `pnpm format:fix` and `pnpm lint:fix`, or commit with --no-verify.\n' >&2
  fi
  rm -rf "$work"
  exit "$status"
}
trap report EXIT

# Formatters the template does not run. PROJECT_EXTENSIONS lists the extensions they own, as a `grep -E`
# alternation such as `rs` or `go|proto`; those files go to them instead of oxfmt. project_fix rewrites and
# project_check checks the newline-delimited file list in "$1", typically through run_on, as in
# `run_on "$1" rustfmt --check --`. Empty, the hook runs only the template's tools.
PROJECT_EXTENSIONS=
project_fix() { :; }
project_check() { :; }

# `core.quotePath=false` lists a path with non-ASCII characters as it is. Quoted, as
# `"caf\303\251.md"`, it would match no extension below and go unchecked.
git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR |
  grep -E "\.(astro|cjs|css|cts|html|js|json|jsx|md|mjs|mts|svelte|ts|tsx${PROJECT_EXTENSIONS:+|$PROJECT_EXTENSIONS})\$" >"$work/staged" || true

if [ ! -s "$work/staged" ]; then
  exit 0
fi

git -c core.quotePath=false diff --name-only >"$work/unstaged" || true
grep -Fxv -f "$work/unstaged" "$work/staged" >"$work/fixable" || true

# Runs a command over a newline-delimited file list, skipping an empty one.
run_on() {
  list=$1
  shift
  if [ -s "$list" ]; then
    tr '\n' '\0' <"$list" | xargs -0 "$@"
  fi
}

# oxlint reads code only, and exits non-zero when handed nothing it can parse. It
# also exits non-zero when every file it is handed matches its ignorePatterns,
# which `--no-error-on-unmatched-pattern` turns back into a pass: committing a
# file the lint config deliberately ignores is not a lint failure.
select_code() {
  grep -E '\.(cjs|cts|js|jsx|mjs|mts|ts|tsx)$' "$1" >"$2" || true
}

# oxfmt does not format Markdown; Prettier does, and skips anything .prettierignore lists.
select_md() {
  grep -E '\.md$' "$1" >"$2" || true
}

# Splits a file list between the project's formatters and oxfmt.
select_project() {
  if [ -n "$PROJECT_EXTENSIONS" ]; then
    grep -E "\.($PROJECT_EXTENSIONS)\$" "$1" >"$2" || true
  else
    : >"$2"
  fi
}
select_web() {
  grep -Fxv -f "$3" "$1" >"$2" || true
}

if [ -s "$work/fixable" ]; then
  select_project "$work/fixable" "$work/fixable-project"
  select_web "$work/fixable" "$work/fixable-web" "$work/fixable-project"
  run_on "$work/fixable-web" pnpm exec oxfmt --no-error-on-unmatched-pattern --
  if [ -s "$work/fixable-project" ]; then
    project_fix "$work/fixable-project"
  fi
  select_md "$work/fixable" "$work/fixable-md"
  run_on "$work/fixable-md" pnpm exec prettier --write --log-level warn --
  select_code "$work/fixable" "$work/fixable-code"
  run_on "$work/fixable-code" pnpm exec oxlint --fix --no-error-on-unmatched-pattern --
  # Literal pathspecs, so a name such as `app/[id]/page.tsx` is not read as a
  # pattern that also stages the unstaged changes of `app/i/page.tsx`.
  run_on "$work/fixable" git --literal-pathspecs add --
fi

select_project "$work/staged" "$work/project"
select_web "$work/staged" "$work/web" "$work/project"
run_on "$work/web" pnpm exec oxfmt --check --no-error-on-unmatched-pattern --
if [ -s "$work/project" ]; then
  project_check "$work/project"
fi
select_md "$work/staged" "$work/md"
run_on "$work/md" pnpm exec prettier --check --log-level warn --
select_code "$work/staged" "$work/code"
run_on "$work/code" pnpm exec oxlint --deny-warnings --no-error-on-unmatched-pattern --
