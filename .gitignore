# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies
node_modules

# Build output and caches
dist
coverage
*.tsbuildinfo
test-results
playwright-report

# Local environment and credentials; an example file is committed instead.
.env
.env.*
!.env.example

# AI agents: every agent directory is ignored, including the settings and skills a tool treats as
# shared. Contributors use different harnesses, skills, and settings, so committing one person's setup
# would impose it on everyone else. AGENTS.md holds the shared instructions; a harness that does not read it
# by default, such as Gemini CLI, is pointed at it in each contributor's own settings.
.agents
.antigravity
.claude
.cline
.codex
.cursor
.gemini
.kiro
.opencode
.trae
.windsurf
.zcode

# Short-lived plans (docs/guidelines/documentation.md, "What belongs here").
docs/plans

# Framework caches and generated test output.
.astro
.wrangler
**/.palette-tmp
**/tests/**/output.css

# Build-time tag-scoped snapshots and their logo copies (docs/ci.md, "Publish-scoped content")
/apps/docs/.codenhub-published-docs/
/apps/www/.codenhub-published/
/apps/www/public/logos/

# Build-time copies of the brand at coden.agency/brand (docs/specs/packages-demo.md)
**/.codenhub-assets.json
/apps/www/public/assets/
/apps/www/public/favicon.ico
/apps/docs/public/assets/
/apps/docs/public/favicon.ico
/apps/demo/public/assets/
/apps/demo/public/favicon.ico
/packages/*/demo/public/assets/
/packages/*/demo/public/favicon.ico

# Svelte components the @codenhub/error tests compile
**/.svelte-test
