{
  "$schema": "./registry.schema.json",
  "version": 1,
  "presentation": {
    "fill": {
      "solid": {
        "ui-fill": "100%",
        "ui-fg-on-fill": "100%"
      },
      "soft": {
        "ui-fill": "12%",
        "ui-fg-on-fill": "0%"
      },
      "bare": {
        "ui-fill": "0%",
        "ui-fg-on-fill": "0%"
      }
    },
    "edge": {
      "edged": {
        "ui-border": "100%"
      },
      "edgeless": {
        "ui-border": "0%"
      }
    },
    "hoverStep": "14%"
  },
  "intents": {
    "neutral": {
      "family": "text"
    },
    "primary": {
      "family": "primary"
    },
    "secondary": {
      "family": "accent"
    },
    "success": {
      "family": "success"
    },
    "warning": {
      "family": "warning"
    },
    "destructive": {
      "family": "destructive",
      "aliases": ["danger", "error"]
    },
    "info": {
      "family": "info"
    }
  },
  "modifiers": {
    "elevation": {
      "flat": {
        "ui-elevation": "0"
      },
      "raised": {
        "ui-elevation": "1"
      },
      "floating": {
        "ui-elevation": "2"
      }
    },
    "size": ["sm", "lg"],
    "padding": ["compact", "spacious", "flush"],
    "shape": ["pill"],
    "state": ["loading", "disabled", "interactive", "active", "indeterminate"],
    "layout": ["vertical", "horizontal", "between", "tight", "loose", "narrow", "wide"]
  },
  "components": [
    {
      "class": "btn",
      "default": {
        "fill": "solid",
        "edge": "edgeless",
        "elevation": 1
      },
      "native": ["button", "input[type=\"submit\"]", "input[type=\"reset\"]", "input[type=\"button\"]"]
    },
    {
      "class": "ipt",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": [
        "input:not([type=\"checkbox\"], [type=\"radio\"], [type=\"submit\"], [type=\"reset\"], [type=\"button\"])"
      ]
    },
    {
      "class": "card",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 1
      },
      "native": []
    },
    {
      "class": "badge",
      "default": {
        "fill": "soft",
        "edge": "edgeless",
        "elevation": 0
      },
      "native": []
    },
    {
      "class": "loader",
      "default": {
        "elevation": 0
      },
      "art": [
        "dots-wave",
        "dots-fade",
        "dots-queue",
        "dots-rotate",
        "dots-grow",
        "dots-grow-alternate",
        "dot-bounce",
        "bars-wave",
        "pulse-ring"
      ],
      "native": []
    },
    {
      "class": "textarea",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["textarea"]
    },
    {
      "class": "select",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["select"]
    },
    {
      "class": "checkbox",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["input[type=\"checkbox\"]"]
    },
    {
      "class": "radio",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["input[type=\"radio\"]"]
    },
    {
      "class": "switch",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": []
    },
    {
      "class": "panel",
      "default": {
        "fill": "soft",
        "edge": "edgeless",
        "elevation": 0
      },
      "native": []
    },
    {
      "class": "alert",
      "default": {
        "fill": "soft",
        "edge": "edged",
        "elevation": 0
      },
      "native": []
    },
    {
      "class": "data-table",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["table"],
      "renamedFrom": "table",
      "renameReason": "`.table` is a Tailwind static utility for `display: table`; the package's version replaced it for every consumer.",
      "composition": "frame",
      "compositionReason": "Takes its border, radius and clip from `box` and paints its head, cell rules and row hover from private tokens, which have no equivalent on the three axes. Its `overflow: hidden` over `border-separate` also does not compose with an aesthetic's `clip-path`."
    },
    {
      "class": "empty-state",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": []
    },
    {
      "class": "pre",
      "default": {
        "fill": "bare",
        "edge": "edgeless",
        "ground": "--intent-subtle",
        "elevation": 0
      },
      "native": ["pre"]
    },
    {
      "class": "quote",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["blockquote"],
      "composition": "none",
      "compositionReason": "Typography rather than a painted box. The component is a left bar and an indent, so `box`'s background, edge, radius and shadow would all be inert on it."
    },
    {
      "class": "tooltip",
      "default": {
        "fill": "solid",
        "edge": "edgeless",
        "elevation": 2
      },
      "native": []
    },
    {
      "class": "kbd",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "ground": "--intent-subtle",
        "elevation": 0
      },
      "native": ["kbd"]
    },
    {
      "class": "code",
      "default": {
        "fill": "bare",
        "edge": "edgeless",
        "ground": "--intent-subtle",
        "elevation": 0
      },
      "native": ["code"]
    },
    {
      "class": "skeleton",
      "default": {
        "elevation": 0
      },
      "native": []
    },
    {
      "class": "progress",
      "default": {
        "elevation": 0
      },
      "native": []
    },
    {
      "class": "divider",
      "default": {
        "elevation": 0
      },
      "native": ["hr"]
    }
  ],
  "helpers": [
    "field",
    "control",
    "label",
    "hint",
    "icon",
    "table-wrap",
    "quote-inline",
    "view",
    "stack",
    "cluster",
    "auto-grid",
    "section",
    "section-content",
    "text-display",
    "text-title-lg",
    "text-title",
    "text-title-sm",
    "text-label-lg",
    "text-label",
    "text-body",
    "selection-contrast"
  ],
  "aesthetics": [
    {
      "class": "neobrutalism",
      "completeShadow": false
    },
    {
      "class": "glass",
      "completeShadow": true,
      "completeShadowReason": "Two shadow layers with negative spread, given whole through the surface's --ui-surface-shadow. Opts out of the elevation multiplier until expressed as parts."
    },
    {
      "class": "pixel",
      "completeShadow": false
    }
  ]
}
