{
  "$schema": "./registry.schema.json",
  "version": 1,
  "presentation": {
    "fill": {
      "solid": {
        "ui-fill": "100%",
        "ui-fg-on-fill": "100%"
      },
      "soft": {
        "ui-fill": "12%",
        "ui-fg-on-fill": "0%"
      },
      "bare": {
        "ui-fill": "0%",
        "ui-fg-on-fill": "0%"
      }
    },
    "edge": {
      "edged": {
        "ui-border": "100%"
      },
      "edgeless": {
        "ui-border": "0%"
      }
    },
    "hoverStep": "14%"
  },
  "intents": {
    "neutral": {
      "family": "text",
      "vocabulary": "neutral"
    },
    "primary": {
      "family": "primary",
      "vocabulary": "emphasis"
    },
    "secondary": {
      "family": "accent",
      "vocabulary": "emphasis"
    },
    "success": {
      "family": "success",
      "vocabulary": "semantic"
    },
    "warning": {
      "family": "warning",
      "vocabulary": "semantic"
    },
    "destructive": {
      "family": "destructive",
      "vocabulary": "semantic",
      "aliases": ["danger", "error"]
    },
    "info": {
      "family": "info",
      "vocabulary": "semantic"
    }
  },
  "modifiers": {
    "elevation": {
      "flat": {
        "ui-elevation": "0"
      },
      "raised": {
        "ui-elevation": "1"
      },
      "floating": {
        "ui-elevation": "2"
      }
    },
    "size": ["sm", "lg"],
    "padding": ["compact", "spacious", "flush"],
    "shape": ["pill"],
    "state": ["loading", "disabled", "interactive", "active", "indeterminate"],
    "layout": ["vertical", "horizontal", "between", "tight", "loose", "narrow", "wide"]
  },
  "components": [
    {
      "class": "btn",
      "default": {
        "fill": "solid",
        "edge": "edgeless",
        "elevation": 1
      },
      "native": ["button", "input[type=\"submit\"]", "input[type=\"reset\"]", "input[type=\"button\"]"],
      "wave": 1
    },
    {
      "class": "ipt",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": [
        "input:not([type=\"checkbox\"], [type=\"radio\"], [type=\"submit\"], [type=\"reset\"], [type=\"button\"])"
      ],
      "wave": 1
    },
    {
      "class": "card",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 1
      },
      "native": [],
      "wave": 1
    },
    {
      "class": "badge",
      "default": {
        "fill": "soft",
        "edge": "edgeless",
        "elevation": 0
      },
      "native": [],
      "wave": 1
    },
    {
      "class": "loader",
      "default": {
        "elevation": 0
      },
      "art": [
        "dots-wave",
        "dots-fade",
        "dots-queue",
        "dots-rotate",
        "dots-grow",
        "dots-grow-alternate",
        "dot-bounce",
        "bars-wave",
        "pulse-ring"
      ],
      "native": [],
      "wave": 1
    },
    {
      "class": "textarea",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["textarea"],
      "wave": 2
    },
    {
      "class": "select",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["select"],
      "wave": 2
    },
    {
      "class": "checkbox",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["input[type=\"checkbox\"]"],
      "wave": 2
    },
    {
      "class": "radio",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["input[type=\"radio\"]"],
      "wave": 2
    },
    {
      "class": "switch",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": [],
      "wave": 2
    },
    {
      "class": "panel",
      "default": {
        "fill": "soft",
        "edge": "edgeless",
        "elevation": 0
      },
      "native": [],
      "wave": 2
    },
    {
      "class": "alert",
      "default": {
        "fill": "soft",
        "edge": "edged",
        "elevation": 0
      },
      "native": [],
      "wave": 2
    },
    {
      "class": "data-table",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["table"],
      "renamedFrom": "table",
      "renameReason": "`.table` is a Tailwind static utility for `display: table`; the package's version replaced it for every consumer.",
      "wave": 2
    },
    {
      "class": "empty-state",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": [],
      "wave": 2
    },
    {
      "class": "pre",
      "default": {
        "fill": "soft",
        "edge": "edgeless",
        "elevation": 0
      },
      "native": ["pre"],
      "wave": 2
    },
    {
      "class": "quote",
      "default": {
        "fill": "bare",
        "edge": "edged",
        "elevation": 0
      },
      "native": ["blockquote"],
      "wave": 2
    },
    {
      "class": "tooltip",
      "default": {
        "fill": "solid",
        "edge": "edgeless",
        "elevation": 2
      },
      "native": [],
      "wave": 2
    },
    {
      "class": "kbd",
      "default": {
        "fill": "soft",
        "edge": "edgeless",
        "elevation": 0
      },
      "native": ["kbd"],
      "wave": 2
    },
    {
      "class": "code",
      "default": {
        "fill": "soft",
        "edge": "edgeless",
        "elevation": 0
      },
      "native": ["code"],
      "wave": 2
    },
    {
      "class": "skeleton",
      "default": {
        "elevation": 0
      },
      "native": [],
      "wave": 2
    },
    {
      "class": "progress",
      "default": {
        "elevation": 0
      },
      "native": [],
      "wave": 2
    },
    {
      "class": "divider",
      "default": {
        "elevation": 0
      },
      "native": ["hr"],
      "wave": 2
    }
  ],
  "helpers": [
    {
      "class": "field",
      "purpose": "Wraps label, control, and hint."
    },
    {
      "class": "control",
      "purpose": "Wraps a control alone, so an icon can be a masked pseudo-element over it."
    },
    {
      "class": "label",
      "purpose": "Form label typography."
    },
    {
      "class": "hint",
      "purpose": "Helper text under a control."
    },
    {
      "class": "icon",
      "purpose": "Marks a control or button as carrying an icon."
    },
    {
      "class": "table-wrap",
      "purpose": "Horizontal overflow wrapper for wide tables."
    },
    {
      "class": "quote-inline",
      "purpose": "Inline quotation."
    },
    {
      "class": "view",
      "purpose": "Flex container."
    },
    {
      "class": "stack",
      "purpose": "Vertical flex stack."
    },
    {
      "class": "cluster",
      "purpose": "Wrapping horizontal row."
    },
    {
      "class": "auto-grid",
      "purpose": "Responsive auto-fit grid."
    },
    {
      "class": "section",
      "purpose": "Responsive block padding and inline gutter."
    },
    {
      "class": "section-content",
      "purpose": "Centered container."
    },
    {
      "class": "text-display",
      "purpose": "Typography scale."
    },
    {
      "class": "text-title-lg",
      "purpose": "Typography scale."
    },
    {
      "class": "text-title",
      "purpose": "Typography scale."
    },
    {
      "class": "text-title-sm",
      "purpose": "Typography scale."
    },
    {
      "class": "text-label-lg",
      "purpose": "Typography scale."
    },
    {
      "class": "text-label",
      "purpose": "Typography scale."
    },
    {
      "class": "text-body",
      "purpose": "Typography scale."
    }
  ],
  "aesthetics": [
    {
      "class": "neobrutalism",
      "completeShadow": false
    },
    {
      "class": "glass",
      "completeShadow": true,
      "completeShadowReason": "Two shadow layers with negative spread, given whole through the surface's --ui-surface-shadow. Opts out of the elevation multiplier until expressed as parts."
    },
    {
      "class": "pixel",
      "completeShadow": false
    }
  ],
  "removed": [
    {
      "class": "flat",
      "replacedBy": "solid",
      "note": "`.flat` returns as an elevation modifier meaning no depth."
    },
    {
      "class": "out",
      "replacedBy": "bare edged"
    },
    {
      "class": "ghost",
      "replacedBy": "bare"
    },
    {
      "class": "fill",
      "replacedBy": null,
      "note": "Hover is derived. `.out.fill` has no replacement."
    },
    {
      "class": "control-base",
      "replacedBy": null,
      "note": "Became the `text-control` utility; it was never a component."
    },
    {
      "class": "ai",
      "replacedBy": "loader",
      "note": "Loader artwork is an art variant, not a separate class."
    }
  ]
}
