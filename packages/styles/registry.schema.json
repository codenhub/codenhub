{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenhub.dev/styles/registry.schema.json",
  "title": "Codenhub styles registry",
  "description": "The source of truth for what @codenhub/styles supports. Read by tests/integration/registry.test.ts, which checks it against the hand-written stylesheet and validates registry.json against this schema.",
  "type": "object",
  "required": ["version", "presentation", "intents", "modifiers", "components"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "presentation": {
      "type": "object",
      "required": ["fill", "edge", "hoverStep"],
      "additionalProperties": false,
      "properties": {
        "fill": {
          "type": "object",
          "description": "Fill sub-axis. Keys are class names, values the presentation tokens they declare.",
          "additionalProperties": {
            "type": "object",
            "required": ["ui-fill", "ui-fg-on-fill"],
            "additionalProperties": false,
            "properties": {
              "ui-fill": {
                "type": "string",
                "pattern": "^\\d+%$"
              },
              "ui-fg-on-fill": {
                "type": "string",
                "pattern": "^\\d+%$"
              }
            }
          }
        },
        "edge": {
          "type": "object",
          "description": "Edge sub-axis.",
          "additionalProperties": {
            "type": "object",
            "required": ["ui-border"],
            "additionalProperties": false,
            "properties": {
              "ui-border": {
                "type": "string",
                "pattern": "^\\d+%$"
              }
            }
          }
        },
        "hoverStep": {
          "type": "string",
          "pattern": "^\\d+%$",
          "description": "How much fill a hover adds. Hover is derived from this, never declared per class."
        }
      }
    },
    "intents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["family"],
        "additionalProperties": false,
        "properties": {
          "family": {
            "type": "string",
            "description": "The --color-* family this intent maps onto. Checked against intent.css."
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "modifiers": {
      "type": "object",
      "required": ["elevation"],
      "properties": {
        "elevation": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["ui-elevation"],
            "additionalProperties": false,
            "properties": {
              "ui-elevation": {
                "type": "string",
                "pattern": "^\\d+$"
              }
            }
          }
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "default", "native", "wave"],
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "default": {
            "type": "object",
            "required": ["elevation"],
            "additionalProperties": false,
            "properties": {
              "fill": {
                "type": "string"
              },
              "edge": {
                "type": "string"
              },
              "elevation": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "art": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Indicator artwork variants, which are not a presentation."
          },
          "native": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Bare element selectors this component maps."
          },
          "renamedFrom": {
            "type": "string"
          },
          "renameReason": {
            "type": "string"
          },
          "wave": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          }
        }
      }
    },
    "helpers": {
      "type": "array",
      "description": "Classes that carry no axis. Listed so collision checking covers them; docs/classes.md describes what each one is for.",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "aesthetics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "completeShadow"],
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "completeShadow": {
            "type": "boolean",
            "description": "True when the aesthetic gives a shadow whole rather than as parts, which opts it out of the elevation multiplier. Checked against the aesthetic's stylesheet."
          },
          "completeShadowReason": {
            "type": "string"
          },
          "selectors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "description": "Components this aesthetic names in a selector because the treatment cannot be a token. R3 keeps this empty; every entry is a cost the registry makes countable."
          },
          "selectorReason": {
            "type": "string",
            "description": "Why each named component cannot be reached through a token. Required when `selectors` is non-empty."
          }
        },
        "dependentRequired": {
          "selectors": ["selectorReason"]
        }
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "replacedBy"],
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": "string"
          },
          "replacedBy": {
            "type": ["string", "null"]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
