{
  "name": "@codenhub/validation",
  "version": "0.4.0",
  "private": false,
  "description": "Zero-dependency validation of untrusted input for TypeScript: formats that return what a parser read, a bounded cost for input that fails, issues that never hold a value of the input, and tree-shakable validators.",
  "homepage": "https://github.com/codenhub/codenhub/tree/main/packages/validation",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codenhub/codenhub.git",
    "directory": "packages/validation"
  },
  "files": [
    "dist",
    "docs",
    "llms.txt",
    "llms-full.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "pnpm build && node bench/run.mjs",
    "build": "tsdown src/index.ts --tsconfig tsconfig.src.json --format esm --dts --clean --no-fixed-extension",
    "prepublishOnly": "pnpm build && pnpm typecheck",
    "status:npm": "npm view @codenhub/validation version dist-tags time --json && npm dist-tag ls @codenhub/validation && npm access get status @codenhub/validation",
    "status:pack": "npm pack --dry-run --ignore-scripts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:watch": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "codenhub": {
    "docs": {
      "label": "ValidationKit",
      "status": "experimental",
      "reference": {}
    }
  }
}
