{
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "tsBuildInfoFile": "./tsconfig.test.tsbuildinfo"
  },
  "extends": "../../tsconfig.json",
  "include": ["src/**/*", "tests/**/*.ts", "playwright.config.ts", "vitest.config.ts"],
  "exclude": ["src/runtime-globals.d.ts"]
}
