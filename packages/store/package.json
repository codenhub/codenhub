{
  "name": "@codenhub/store",
  "version": "0.0.2",
  "private": false,
  "description": "Small typed records persisted to key-value backends.",
  "homepage": "https://github.com/codenhub/codenhub/tree/main/packages/store",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codenhub/codenhub.git",
    "directory": "packages/store"
  },
  "files": [
    "dist",
    "docs",
    "!docs/internal",
    "llms.txt",
    "llms-full.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./cf": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/node.ts src/cloudflare.ts --format esm --dts --clean --no-fixed-extension",
    "prepublishOnly": "pnpm build && pnpm typecheck",
    "status:npm": "npm view @codenhub/store version dist-tags time --json && npm dist-tag ls @codenhub/store && npm access get status @codenhub/store",
    "status:pack": "npm pack --dry-run --ignore-scripts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:watch": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@codenhub/error": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "miniflare": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "codenhub": {
    "label": "StoreSystem",
    "status": "experimental",
    "docs": {}
  }
}
