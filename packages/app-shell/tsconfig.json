{
  // astro-check loads typescript as a peer to check the Astro components.
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "lib": ["ESNext", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.astro"]
}
