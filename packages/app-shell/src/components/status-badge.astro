---
/**
 * Renders the deprecated/experimental badge for a package status. `active`
 * carries no badge: marking every healthy package makes the ones that need
 * attention harder to spot.
 *
 * @param status - The package's lifecycle status.
 * @param compact - Show the icon alone, with the label as its accessible name and native tooltip.
 * @param labels - Each status's label in the page's language.
 */
import type { PackageStatus } from "@codenhub/tools/documentation";

import { defaultShellMessages, type ShellMessages } from "../messages.ts";

interface Props {
  status: PackageStatus;
  compact?: boolean;
  /** Each status's label in the page's language. Defaults to English. */
  labels?: ShellMessages["status"];
}

const { compact = false, labels = defaultShellMessages.status, status } = Astro.props;

const badges = {
  deprecated: { icon: "ic-lucide-ban", label: labels.deprecated, tone: "destructive" },
  experimental: { icon: "ic-lucide-flask-conical", label: labels.experimental, tone: "warning" },
} as const;

const badge = status === "active" ? undefined : badges[status];
---

{
  badge !== undefined && (
    <span
      aria-label={compact ? badge.label : undefined}
      class:list={["badge", "soft", "status-badge", badge.tone, { "status-badge-compact": compact }]}
      role={compact ? "img" : undefined}
      title={compact ? badge.label : undefined}
    >
      <i aria-hidden="true" class:list={[badge.icon, "status-badge-icon"]} />
      {!compact && badge.label}
    </span>
  )
}
