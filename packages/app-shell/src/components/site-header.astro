---
import { resolveNavLinks, type ShellNavLink } from "../nav.ts";
import type { SiteConfig } from "../site-config.ts";
import ThemeToggle from "./theme-toggle.astro";

interface Props {
  siteConfig: SiteConfig;
  /** Home link target. Defaults to this surface's own root. */
  homeHref?: string;
  /** Accessible label for the GitHub action, when `siteConfig.githubUrl` points at a specific package rather than the monorepo root. */
  githubLabel?: string;
  /** Accessible label for the npm action, when `siteConfig.npmUrl` points at a specific package rather than the org page. */
  npmLabel?: string;
  /** Links within this surface, shown before the cross-surface links. They open in the same tab, with no outbound arrow. */
  localLinks?: ShellLocalLink[];
}

/** A header link within the current surface. `current` marks the page, or section, the visitor is on. */
export interface ShellLocalLink extends ShellNavLink {
  current?: boolean;
}

const {
  siteConfig,
  homeHref = "/",
  githubLabel = "CodenHub on GitHub",
  npmLabel = "CodenHub on npm",
  localLinks = [],
} = Astro.props;

/*
 * The standard cross-surface links, left of the brand actions, after any of
 * the surface's own `localLinks`. Every one points at another origin, so it
 * opens in a new tab and carries the outbound arrow.
 *
 * DOM order is brand, links, actions at every width — the wide row shows them
 * in that order, and the narrow layout keeps the links on the brand's row and
 * drops the actions below, so keyboard focus always follows the visible order.
 */
const navLinks = resolveNavLinks(siteConfig);
---

<header class="shell-header">
  <div class="shell-header-content">
    <a aria-label={`${siteConfig.title} home`} class="shell-brand" href={homeHref}>
      <img
        alt=""
        aria-hidden="true"
        class="shell-brand-logo shell-brand-logo-on-light"
        height="255"
        src="/assets/logo/logo-dark.svg"
        width="984"
      />
      <img
        alt=""
        aria-hidden="true"
        class="shell-brand-logo shell-brand-logo-on-dark"
        height="255"
        src="/assets/logo/logo-light.svg"
        width="984"
      />
    </a>
    {
      localLinks.length + navLinks.length > 0 && (
        <nav aria-label="Sites" class="shell-nav">
          {localLinks.map((link) => (
            <a aria-current={link.current === true ? "page" : undefined} class="shell-nav-link" href={link.href}>
              {link.label}
            </a>
          ))}
          {navLinks.map((link) => (
            <a class="shell-nav-link" href={link.href} rel="noopener noreferrer" target="_blank">
              {link.label}
              <i aria-hidden="true" class="ic-lucide-arrow-up-right shell-nav-link-arrow" />
            </a>
          ))}
        </nav>
      )
    }
    <div class="shell-actions">
      <slot name="actions" />
      <a
        aria-label={githubLabel}
        class="shell-action"
        href={siteConfig.githubUrl}
        rel="noopener noreferrer"
        target="_blank"
      >
        <i aria-hidden="true" class="ic-simple-icons-github shell-action-brand"></i>
      </a>
      {
        siteConfig.npmUrl !== undefined && (
          <a
            aria-label={npmLabel}
            class="shell-action"
            href={siteConfig.npmUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            <i aria-hidden="true" class="ic-simple-icons-npm shell-action-brand"></i>
          </a>
        )
      }
      <ThemeToggle />
    </div>
  </div>
</header>
