---
/**
 * Shared footer. `base-layout.astro` fills the year on load; the markup ships a
 * static fallback so the line reads before hydration and without scripts.
 */
const currentYear = new Date().getFullYear();
---

<footer class="shell-footer">
  <div class="shell-footer-content">
    <p>&copy; <span data-footer-year>{currentYear}</span> Coden</p>
    <p>Built by <a href="https://coden.agency/" rel="noopener noreferrer" target="_blank">coden</a>.</p>
  </div>
</footer>
