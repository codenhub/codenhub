---
/**
 * Sends a visitor arriving at an English page to the same page in their
 * language: the one they chose in any CodenHub site's language menu (the
 * locale cookie, `../locales.ts`), else the first of their browser's languages
 * the site has. Render it in the head of English pages only.
 *
 * Inline so it runs before first paint, which is also why it mirrors
 * `pickArrivalLocale` rather than importing it. It never runs on a prefixed
 * URL, so a shared `/pt-BR/` link always opens in Portuguese, and never after
 * a link from a CodenHub site, so choosing English stays English even where
 * cookies are blocked.
 *
 * @param targets - This page in every other locale, by locale.
 */
import { LOCALE_COOKIE, LOCALE_COOKIE_DOMAIN, SITE_LOCALES } from "../locales.ts";

interface Props {
  targets: Readonly<Record<string, string>>;
}

const { targets } = Astro.props;
---

<script
  define:vars={{ cookieName: LOCALE_COOKIE, domain: LOCALE_COOKIE_DOMAIN, locales: SITE_LOCALES, targets }}
  is:inline
>
  (() => {
    try {
      if (document.referrer !== "") {
        const from = new URL(document.referrer).hostname;
        if (from === location.hostname || from === domain || from.endsWith("." + domain)) {
          return;
        }
      }
    } catch {
      // An unreadable referrer counts as arriving from elsewhere.
    }

    let chosen = null;
    for (const part of document.cookie.split(";")) {
      const [name, ...value] = part.trim().split("=");
      if (name === cookieName) {
        try {
          chosen = decodeURIComponent(value.join("="));
        } catch {
          // A malformed value counts as no choice.
        }
      }
    }

    let target = locales.includes(chosen) ? chosen : undefined;
    if (target === undefined) {
      const preferences = navigator.languages.length > 0 ? navigator.languages : [navigator.language];
      for (const preference of preferences) {
        const language = (preference ?? "").split("-")[0].toLowerCase();
        target = locales.find((locale) => locale.split("-")[0].toLowerCase() === language);
        if (target !== undefined) {
          break;
        }
      }
    }

    if (target !== undefined && Object.hasOwn(targets, target)) {
      location.replace(targets[target] + location.search + location.hash);
    }
  })();
</script>
