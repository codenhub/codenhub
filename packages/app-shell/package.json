{
  "name": "@codenhub/app-shell",
  "version": "0.0.0",
  "private": true,
  "description": "Shared chrome, theme handling, and SEO helpers for the CodenHub deploy surfaces.",
  "type": "module",
  "exports": {
    "./layouts/base-layout.astro": "./src/layouts/base-layout.astro",
    "./components/site-header.astro": "./src/components/site-header.astro",
    "./components/site-footer.astro": "./src/components/site-footer.astro",
    "./components/status-badge.astro": "./src/components/status-badge.astro",
    "./components/theme-toggle.astro": "./src/components/theme-toggle.astro",
    "./package-grid": "./src/package-grid.ts",
    "./package-links": "./src/package-links.ts",
    "./copy-feedback": "./src/copy-feedback.ts",
    "./remark-alerts": "./src/remark-alerts.ts",
    "./nav": "./src/nav.ts",
    "./theme": "./src/theme.ts",
    "./site-config": "./src/site-config.ts",
    "./seo": "./src/seo.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "astro-check"
  },
  "dependencies": {
    "@codenhub/icons": "workspace:*",
    "@codenhub/styles": "workspace:*",
    "@codenhub/tools": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "astro": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
