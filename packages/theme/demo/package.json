{
  "name": "@codenhub/theme-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@codenhub/app-shell": "workspace:*",
    "@codenhub/icons": "workspace:*",
    "@codenhub/styles": "workspace:*",
    "@codenhub/theme": "workspace:*",
    "@codenhub/vite-plugin-icons": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  },
  "codenhub": {
    "assets": [
      {
        "from": "favicon/favicon.ico",
        "to": "public/favicon.ico"
      },
      {
        "from": "logo/logo-dark.svg",
        "to": "public/assets/logo/logo-dark.svg"
      },
      {
        "from": "logo/logo-light.svg",
        "to": "public/assets/logo/logo-light.svg"
      }
    ]
  }
}
