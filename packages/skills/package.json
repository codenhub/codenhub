{
  "name": "@codenhub/skills",
  "version": "0.2.0",
  "private": false,
  "description": "Curated collection of AI agent skills with a built-in installer.",
  "homepage": "https://github.com/codenhub/codenhub/tree/main/packages/skills",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codenhub/codenhub.git",
    "directory": "packages/skills"
  },
  "bin": {
    "codenhub-skills": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs/*.md",
    "docs/changelog/*.md",
    "llms.txt",
    "llms-full.txt",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/cli.ts --format esm --clean --no-fixed-extension --no-dts",
    "cli": "pnpm build && node dist/cli.js",
    "prepublishOnly": "pnpm build && pnpm typecheck",
    "status:npm": "npm view @codenhub/skills version dist-tags time --json && npm dist-tag ls @codenhub/skills && npm access get status @codenhub/skills",
    "status:pack": "npm pack --dry-run --ignore-scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "harfbuzzjs": "^1.6.4",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "codenhub": {
    "label": "Coden Skills",
    "status": "active",
    "docs": {}
  }
}
