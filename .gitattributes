# Line endings are normalized to LF in the repository and in the working tree.
# Oxfmt writes LF, so a CRLF checkout would fail `pnpm format:check` on every
# file. `eol=lf` overrides a machine's `core.autocrlf`, which is what makes the
# result the same on every platform.
* text=auto eol=lf

# Binary assets must never be touched by end-of-line conversion.
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.ttf binary
*.webp binary
*.woff binary
*.woff2 binary
