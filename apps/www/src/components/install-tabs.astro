---
/**
 * The install command for each package manager, one tab each, with a copy
 * button. The manager a visitor picks is remembered across package pages.
 * Without JavaScript the first tab's command still shows.
 *
 * @param packageName - Full npm name, such as `@codenhub/validation`.
 * @param locale - The page's locale.
 */
import { getTranslator, type Locale } from "../i18n";
import * as bunIcon from "virtual:@codenhub/icons/logos/bun";
import * as npmIcon from "virtual:@codenhub/icons/logos/npm-icon";
import * as pnpmIcon from "virtual:@codenhub/icons/logos/pnpm";
import * as yarnIcon from "virtual:@codenhub/icons/logos/yarn";
import { decorative } from "../lib/icon";
import CopyButton from "./copy-button.astro";

interface Props {
  packageName: string;
  locale: Locale;
}

const { packageName, locale } = Astro.props;
const { t } = await getTranslator(locale);

// Full-color `logos` marks: `simple-icons` has no Yarn mark (upstream records
// it under CC-BY-4.0, which the family leaves out), and `logos` has all four
// under CC0. Each is its own icon module, since svg mode inlines only literal
// `<i>` tags (`../lib/icon`).
const managers = [
  { brand: "npm", command: `npm install ${packageName}`, icon: decorative(npmIcon) },
  { brand: "pnpm", command: `pnpm add ${packageName}`, icon: decorative(pnpmIcon) },
  { brand: "yarn", command: `yarn add ${packageName}`, icon: decorative(yarnIcon) },
  { brand: "bun", command: `bun add ${packageName}`, icon: decorative(bunIcon) },
];
---

<div class="install-tabs" data-install-tabs>
  <div aria-label={t("package.install.packageManager")} class="www-tablist" role="tablist">
    {
      managers.map(({ brand, icon }, index) => (
        <button
          aria-controls={`install-panel-${brand}`}
          aria-selected={index === 0 ? "true" : "false"}
          class="www-tab"
          data-manager={brand}
          id={`install-tab-${brand}`}
          role="tab"
          tabindex={index === 0 ? 0 : -1}
          type="button"
        >
          <Fragment set:html={icon} />
          {brand}
        </button>
      ))
    }
  </div>
  {
    managers.map(({ brand, command }, index) => (
      <div
        aria-labelledby={`install-tab-${brand}`}
        class="install-panel"
        hidden={index !== 0}
        id={`install-panel-${brand}`}
        role="tabpanel"
      >
        <code>{command}</code>
        <CopyButton class="pill" label={t("package.install.copy")} locale={locale} text={command} />
      </div>
    ))
  }
</div>

<script>
  import { bindTabs } from "../lib/tabs";

  const STORAGE_KEY = "codenhub:package-manager";

  for (const root of document.querySelectorAll<HTMLElement>("[data-install-tabs]")) {
    const select = bindTabs(root, (tab) => {
      try {
        localStorage.setItem(STORAGE_KEY, tab.dataset.manager ?? "");
      } catch {
        // The choice just is not remembered.
      }
    });

    // Storage can be unavailable (private windows, blocked site data); the first tab is the fallback.
    let remembered: string | null = null;
    try {
      remembered = localStorage.getItem(STORAGE_KEY);
    } catch {
      // Keep the first tab.
    }
    const initial = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')].find(
      (tab) => tab.dataset.manager === remembered,
    );
    if (initial !== undefined) {
      select(initial);
    }
  }
</script>
