---
/**
 * Every entrypoint a package exports, what it costs, and every name it exports
 * with what importing that name alone costs. Every row shares one grid, so
 * names, bars, and figures line up across entrypoints.
 */
import { getTranslator, type Locale } from "../i18n";
import { type EntrypointRow } from "../lib/bundle-breakdown";
import { formatBytes } from "../lib/package-facts";
import CopyButton from "./copy-button.astro";

interface Props {
  /** Bundler that measured, such as `rolldown@1.2.15`, absent when nothing was. */
  bundler?: string;
  packageName: string;
  rows: EntrypointRow[];
  locale: Locale;
}

const { bundler, packageName, rows, locale } = Astro.props;
const { t } = await getTranslator(locale);
const minified = t("package.entrypoints.minified").toLowerCase();
const gzipped = t("package.entrypoints.gzipped").toLowerCase();
const hasSizes = rows.some((row) => row.size !== undefined);
const hasExports = rows.some((row) => row.exports !== undefined && row.exports.length > 0);
const isMissingExports = rows.some((row) => row.size !== undefined && row.exports === undefined);
const toSpecifier = (subpath: string): string => (subpath === "." ? packageName : `${packageName}${subpath.slice(1)}`);
---

<div class="bundle">
  {
    hasSizes && (
      <div aria-hidden="true" class="bundle-line bundle-columns">
        <span>{t("package.entrypoints.import")}</span>
        <span />
        <span class="bundle-figure">{t("package.entrypoints.minified")}</span>
        <span class="bundle-figure">{t("package.entrypoints.gzipped")}</span>
      </div>
    )
  }

  {
    rows.map(({ exports, size, subpath }) => {
      const specifier = toSpecifier(subpath);
      return (
        <section aria-label={specifier} class="bundle-entry">
          <div class="bundle-line bundle-entry-line">
            <span class="bundle-name">
              <code>{specifier}</code>
              <CopyButton label={t("package.entrypoints.copyImport")} locale={locale} text={specifier} />
            </span>
            {hasSizes && <span />}
            {hasSizes && (
              <span class="bundle-figure">
                {size === undefined ? "—" : formatBytes(size.minified, locale)}
                <span class="visually-hidden"> {minified}</span>
              </span>
            )}
            {hasSizes && (
              <span class="bundle-figure">
                {size === undefined ? "—" : formatBytes(size.gzip, locale)}
                <span class="visually-hidden"> {gzipped}</span>
              </span>
            )}
          </div>

          {exports !== undefined && exports.length > 0 && (
            <ul aria-label={t("package.entrypoints.exportsOf", { specifier })} class="bundle-list">
              {exports.map((row) => (
                <li class="bundle-line">
                  <span class="bundle-name">
                    <code>{row.name}</code>
                  </span>
                  <span
                    aria-label={t("package.entrypoints.share", { share: row.share })}
                    class="bundle-bar"
                    role="img"
                    style={`--share: ${row.share}`}
                  />
                  <span class="bundle-figure">
                    {formatBytes(row.minified, locale)}
                    <span class="visually-hidden"> {minified}</span>
                  </span>
                  <span class="bundle-figure">
                    {formatBytes(row.gzip, locale)}
                    <span class="visually-hidden"> {gzipped}</span>
                  </span>
                </li>
              ))}
            </ul>
          )}
          {exports !== undefined && exports.length === 0 && (
            <p class="bundle-line bundle-muted">{t("package.entrypoints.noRuntime")}</p>
          )}
        </section>
      );
    })
  }

  {
    hasSizes && (
      <p class="package-note">
        {
          bundler === undefined
            ? t("package.entrypoints.measured")
            : t("package.entrypoints.measuredWith", { bundler })
        }
        {hasExports && ` ${t("package.entrypoints.exportCost")}`}
        {isMissingExports && ` ${t("package.entrypoints.missingExports")}`}
      </p>
    )
  }
</div>
