---
/**
 * One package in the index grid: a summary that opens the package's own page.
 *
 * Top right carries the latest stable version and, for a package that is not
 * active, its status as an icon. Bottom right carries when the package last
 * published, which is a release of any kind, pre-releases included.
 *
 * @param entry - The package as the catalog describes it.
 * @param locale - The page's locale.
 */
import StatusBadge from "@codenhub/app-shell/components/status-badge.astro";

import { getTranslator, routing, shellMessages, type Locale } from "../i18n";
import { formatDate } from "../lib/format";
import type { CatalogPackage } from "../lib/catalog";

interface Props {
  entry: CatalogPackage;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { t } = await getTranslator(locale);
const latest = entry.releases.latest;
const lastRelease = entry.releases.lastPublished;
const haystack = `${entry.label} ${entry.name} ${entry.description ?? ""}`.toLowerCase();
---

<div class="package-card" data-label={entry.label} data-search={haystack} role="listitem">
  <a class="package-card-open" href={routing.localize(`/packages/${entry.slug}/`, locale)}>
    <div class="package-card-heading">
      <div class="package-card-title">
        {entry.logoUrl !== undefined && <img alt="" class="package-card-logo" src={entry.logoUrl} />}
        <h3>{entry.label}</h3>
      </div>
      <div class="package-card-badges">
        {latest !== undefined && <span class="badge secondary soft package-card-version">v{latest.version}</span>}
        {entry.status !== undefined && <StatusBadge compact labels={shellMessages(t).status} status={entry.status} />}
      </div>
    </div>
    <p>{entry.description ?? entry.name}</p>
  </a>
  <div class="package-card-links">
    {
      entry.links.github !== undefined && (
        <a
          aria-label={t("packages.card.github", { name: entry.label })}
          class="package-card-link"
          href={entry.links.github}
          rel="noopener noreferrer"
          target="_blank"
        >
          <i aria-hidden="true" class="ic-simple-icons-github package-card-brand"></i>
        </a>
      )
    }
    <a
      aria-label={t("packages.card.npm", { name: entry.label })}
      class="package-card-link"
      href={entry.links.npm}
      rel="noopener noreferrer"
      target="_blank"
    >
      <i aria-hidden="true" class="ic-simple-icons-npm package-card-brand"></i>
    </a>
    {
      lastRelease !== undefined && (
        <time class="package-card-updated" datetime={lastRelease.date} title={t("packages.card.lastPublished")}>
          {formatDate(lastRelease.date, locale)}
        </time>
      )
    }
  </div>
</div>
