---
/**
 * Icon button that copies a text to the clipboard and shows whether it did.
 *
 * @param text - What the button copies.
 * @param label - Accessible name and tooltip at rest, such as `Copy command`.
 * @param class - Extra button classes, such as `pill`.
 */
interface Props {
  text: string;
  label: string;
  class?: string;
}

const { text, label, class: className } = Astro.props;
---

<button aria-label={label} class:list={["btn secondary ghost icon sm", className]} data-copy={text} title={label} type="button">
  <i aria-hidden="true" class="ic-lucide-copy" data-copy-icon="idle"></i>
  <i aria-hidden="true" class="ic-lucide-check" data-copy-icon="copied"></i>
  <i aria-hidden="true" class="ic-lucide-x" data-copy-icon="failed"></i>
</button>
<span class="visually-hidden" data-copy-status role="status"></span>

<script>
  import { createCopyController } from "@codenhub/app-shell/copy-feedback";

  const copyController = createCopyController();

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const status = button.nextElementSibling;
    if (!(status instanceof HTMLElement)) {
      continue;
    }
    button.addEventListener("click", () =>
      copyController.copy({ button, clipboard: navigator.clipboard, status, text: button.dataset.copy ?? "" }),
    );
  }
</script>
