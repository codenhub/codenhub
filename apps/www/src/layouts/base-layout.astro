---
/**
 * The shell layout with the documentation search and the language menu in the
 * header's actions and a Packages link in its nav. The index lives on the
 * documentation site, which serves it cross-origin.
 *
 * A page built per locale passes its `locale`; the shell's text, `<html lang>`,
 * the language menu, and the `hreflang` alternates follow it. A page without
 * one, such as the 404, renders in English with neither the menu nor the
 * alternates, since it has no URL in another language.
 *
 * `overlayHeader` makes the header see-through while the page sits at its top,
 * for a page whose hero runs up behind it (the landing page). Every other page
 * keeps the shell's solid header with its rule, as on the other apps.
 */
import type { ComponentProps } from "astro/types";
import { defaultShellMessages } from "@codenhub/app-shell/messages";
import LanguageMenu from "@codenhub/app-shell/components/language-menu.astro";
import LocaleRedirect from "@codenhub/app-shell/components/locale-redirect.astro";
import { localizePath } from "@codenhub/app-shell/locales";
import SearchPalette from "@codenhub/app-shell/components/search-palette.astro";
import ShellLayout from "@codenhub/app-shell/layouts/base-layout.astro";

import {
  defaultLocale,
  getTranslator,
  localeNames,
  locales,
  routing,
  shellMessages,
  type Locale,
} from "../i18n";
import { siteConfig } from "../site-config";

type Props = Omit<ComponentProps<typeof ShellLayout>, "lang" | "messages"> & {
  locale?: Locale;
  overlayHeader?: boolean;
};

const { locale, overlayHeader = false, ...shellProps } = Astro.props;
const translator = locale === undefined ? undefined : await getTranslator(locale);
const messages = translator === undefined ? defaultShellMessages : shellMessages(translator.t);

// The path the site routes on, the same in every locale, such as `/packages/`.
const pathname = routing.parse(Astro.url.pathname)?.pathname ?? Astro.url.pathname;
const href = (path: string) => routing.localize(path, locale ?? defaultLocale);

const localLinks = [
  {
    href: href("/packages/"),
    label: translator?.t("shell.nav.packages") ?? "Packages",
    current: /^\/packages(\/|$)/.test(pathname),
  },
];

const alternates =
  locale === undefined
    ? []
    : [
        ...routing.localizeAll(pathname).map((page) => ({ hreflang: page.locale, pathname: page.pathname })),
        { hreflang: "x-default", pathname: routing.localize(pathname, defaultLocale) },
      ];

// This page in every locale, for the language menu.
const languageOptions = locales.map((target) => ({
  locale: target,
  href: routing.localize(pathname, target),
  name: localeNames[target],
}));

// This page in every other locale, for the inline redirect on English pages.
const redirectTargets = Object.fromEntries(
  locales.filter((target) => target !== defaultLocale).map((target) => [target, routing.localize(pathname, target)]),
);
---

<ShellLayout
  {...shellProps}
  description={shellProps.description ?? translator?.t("site.description")}
  homeHref={href("/")}
  lang={locale ?? defaultLocale}
  localLinks={localLinks}
  messages={messages}
>
  <!-- Sends a visitor arriving at an English page to the one in the language they chose. -->
  {locale === defaultLocale && <LocaleRedirect slot="head" targets={redirectTargets} />}
  {
    alternates.map((alternate) => (
      <link href={new URL(alternate.pathname, siteConfig.siteUrl).href} hreflang={alternate.hreflang} rel="alternate" slot="head" />
    ))
  }
  <SearchPalette
    indexUrl={`${siteConfig.docsUrl}${localizePath(locale ?? defaultLocale, "/search-index.json")}`}
    messages={messages.search}
    slot="actions"
  />
  {
    locale !== undefined && translator !== undefined && (
      <LanguageMenu
        label={translator.t("language.label")}
        locale={locale}
        options={languageOptions}
        slot="actions"
      />
    )
  }
  <!--
    With `overlayHeader`, the header is see-through while the page sits at its
    top, so the landing hero's glyph field runs up behind it, and takes its fill
    and rule once the page scrolls (`global.css`, "Header"). Inline, right after
    the header, so the state is set before first paint rather than flipping
    after a deferred module runs. Without JavaScript neither attribute appears
    and the header stays solid. The header's measured height goes to
    `--www-header-height`, which the hero uses to slide under it, since it grows
    past `--shell-header-height` when its actions wrap to a second row.
  -->
  {
    overlayHeader && (
      <script is:inline>
        (() => {
          const header = document.querySelector(".shell-header");
          if (header === null) {
            return;
          }

          header.setAttribute("data-overlay", "");
          const syncTop = () => header.toggleAttribute("data-at-top", scrollY <= 8);
          syncTop();
          addEventListener("scroll", syncTop, { passive: true });

          const syncHeight = () =>
            document.documentElement.style.setProperty("--www-header-height", `${header.offsetHeight}px`);
          syncHeight();
          new ResizeObserver(syncHeight).observe(header);
        })();
      </script>
    )
  }
  <slot />
</ShellLayout>
