---
import BaseLayout from "../layouts/base-layout.astro";

import { headerConfig } from "../site-config";
import "../styles/global.css";
---

<BaseLayout description="The requested page could not be found." siteConfig={headerConfig} title="Page not found">
  <main class="www-main" id="main-content">
    <div class="shell-content www-hero">
      <h1>Page not found</h1>
      <p>This page moved or never existed. Head back to the package list for every package and where each one lives.</p>
      <p><a href="/packages/">Back to the package list</a></p>
    </div>
  </main>
</BaseLayout>
