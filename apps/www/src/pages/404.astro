---
import BaseLayout from "@codenhub/app-shell/layouts/base-layout.astro";

import { siteConfig } from "../site-config";
import "../styles/global.css";
---

<BaseLayout description="The requested page could not be found." siteConfig={siteConfig} title="Page not found">
  <main class="www-main" id="main-content">
    <div class="www-container www-hero">
      <h1>Page not found</h1>
      <p>This page moved or never existed. Head back to the index for the full list of packages and where each one lives.</p>
      <p><a href="/">Back to the index</a></p>
    </div>
  </main>
</BaseLayout>
