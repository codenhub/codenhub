---
/**
 * One package's page: everything the index knows about it, from its latest
 * release. The page is a stack of sections so a package can later contribute
 * its own (docs/roadmap.md, "Package-provided sections").
 */
import StatusBadge from "@codenhub/app-shell/components/status-badge.astro";
import { localizeUrl } from "@codenhub/app-shell/locales";
import * as bookOpenIcon from "virtual:@codenhub/icons/lucide/book-open";
import * as bookTextIcon from "virtual:@codenhub/icons/lucide/book-text";
import * as botIcon from "virtual:@codenhub/icons/lucide/bot";
import * as boxesIcon from "virtual:@codenhub/icons/lucide/boxes";
import * as calendarIcon from "virtual:@codenhub/icons/lucide/calendar";
import * as fileCodeIcon from "virtual:@codenhub/icons/lucide/file-code";
import * as fileTypeIcon from "virtual:@codenhub/icons/lucide/file-type";
import * as historyIcon from "virtual:@codenhub/icons/lucide/history";
import * as leafIcon from "virtual:@codenhub/icons/lucide/leaf";
import * as networkIcon from "virtual:@codenhub/icons/lucide/network";
import * as packageIcon from "virtual:@codenhub/icons/lucide/package";
import * as packageOpenIcon from "virtual:@codenhub/icons/lucide/package-open";
import * as playIcon from "virtual:@codenhub/icons/lucide/play";
import * as plugIcon from "virtual:@codenhub/icons/lucide/plug";
import * as scaleIcon from "virtual:@codenhub/icons/lucide/scale";
import * as tagIcon from "virtual:@codenhub/icons/lucide/tag";
import * as tagsIcon from "virtual:@codenhub/icons/lucide/tags";
import { decorative } from "../../../lib/icon";
import type { GetStaticPaths } from "astro";

import CopyButton from "../../../components/copy-button.astro";
import Entrypoints from "../../../components/entrypoints.astro";
import InstallTabs from "../../../components/install-tabs.astro";
import { getTranslator, localeStaticPaths, routing, shellMessages, type Locale } from "../../../i18n";
import BaseLayout from "../../../layouts/base-layout.astro";
import { describeEntrypoints } from "../../../lib/bundle-breakdown";
import { catalogPackages, type CatalogPackage } from "../../../lib/catalog";
import { formatDate } from "../../../lib/format";
import { describeRootSize, npmTarballUrl, packageCommand } from "../../../lib/package-facts";
import { renderReadme, selectReadme } from "../../../lib/readme";
import { headerConfig } from "../../../site-config";
import "../../../styles/global.css";

export const getStaticPaths = (() =>
  localeStaticPaths().flatMap(({ params, props }) =>
    catalogPackages.map((entry) => ({ params: { ...params, slug: entry.slug }, props: { ...props, entry } })),
  )) satisfies GetStaticPaths;

interface Props {
  entry: CatalogPackage;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { t } = await getTranslator(locale);
const { links, properties, releases, size } = entry;
const latest = releases.latest;
const rootSize = describeRootSize(size, locale);

// The header's GitHub and npm marks open this package rather than the monorepo and the org.
const packageHeaderConfig = {
  ...headerConfig,
  githubUrl: links.github ?? headerConfig.githubUrl,
  npmUrl: links.npm,
};

interface Link {
  href: string;
  label: string;
  icon: string;
  external: boolean;
}

// Every documentation page exists in every locale, so these keep the reader's language.
// `llms.txt` is English only (`docs/specs/packages-translations.md`).
const linkCandidates: (Link | undefined)[] = [
  links.docs === undefined ? undefined : { href: localizeUrl(links.docs, locale), label: t("package.links.documentation"), icon: decorative(bookOpenIcon), external: false },
  links.changelog === undefined ? undefined : { href: localizeUrl(links.changelog, locale), label: t("package.links.changelog"), icon: decorative(historyIcon), external: false },
  links.demo === undefined ? undefined : { href: links.demo, label: t("package.links.demo"), icon: decorative(playIcon), external: false },
  links.llms === undefined ? undefined : { href: links.llms, label: "llms.txt", icon: decorative(botIcon), external: true },
];
// The first link is the page's main action and keeps its label; the rest are icons with a tooltip.
const [primaryLink, ...secondaryLinks] = linkCandidates.filter((link): link is Link => link !== undefined);

const facts: { icon: string; term: string; value: string }[] = [
  {
    icon: decorative(tagIcon),
    term: t("package.facts.latestVersion"),
    value:
      latest !== undefined
        ? latest.version
        : releases.history.length === 0
          ? t("package.facts.unreleased")
          : t("package.facts.noStable"),
  },
  ...(releases.lastPublished === undefined
    ? []
    : [{ icon: decorative(calendarIcon), term: t("package.facts.lastPublished"), value: formatDate(releases.lastPublished.date, locale) }]),
  ...(entry.license === undefined ? [] : [{ icon: decorative(scaleIcon), term: t("package.facts.license"), value: entry.license }]),
  ...(rootSize === undefined ? [] : [{ icon: decorative(packageIcon), term: t("package.facts.bundleSize"), value: rootSize }]),
  {
    icon: decorative(networkIcon),
    term: t("package.facts.dependencies"),
    value: properties.dependencyCount === 0 ? t("package.facts.none") : String(properties.dependencyCount),
  },
  {
    icon: decorative(plugIcon),
    term: t("package.facts.peerDependencies"),
    value: properties.peerDependencies.length === 0 ? t("package.facts.none") : properties.peerDependencies.join(", "),
  },
  {
    icon: decorative(fileCodeIcon),
    term: t("package.facts.moduleFormat"),
    value: properties.isEsmOnly ? t("package.facts.esmOnly") : t("package.facts.esmAndCjs"),
  },
  {
    icon: decorative(fileTypeIcon),
    term: t("package.facts.types"),
    value: properties.shipsTypes ? t("package.facts.included") : t("package.facts.notIncluded"),
  },
  {
    icon: decorative(leafIcon),
    term: t("package.facts.sideEffectFree"),
    value: properties.isSideEffectFree ? t("package.facts.yes") : t("package.facts.no"),
  },
  ...(properties.bundled.length === 0
    ? []
    : [{ icon: decorative(boxesIcon), term: t("package.facts.bundles"), value: properties.bundled.join(", ") }]),
];

// Every entrypoint the manifest exports, with as much of its cost as the release measured.
const entrypoints = describeEntrypoints(properties.entrypoints, size);

const readme = entry.readme === undefined ? undefined : selectReadme(entry.readme, locale);
const readmeHtml = readme === undefined ? undefined : await renderReadme(readme.source, entry.readme!);

const detailTabs = [
  ...(readmeHtml === undefined ? [] : [{ icon: decorative(bookTextIcon), id: "readme", label: t("package.tabs.readme") }]),
  ...(entrypoints.length === 0 ? [] : [{ icon: decorative(packageOpenIcon), id: "entrypoints", label: t("package.tabs.entrypoints") }]),
  { icon: decorative(tagsIcon), id: "releases", label: t("package.tabs.releases") },
];
// The first tab shows without JavaScript; the others wait for a click.
const isFirstTab = (id: string): boolean => detailTabs[0]?.id === id;
---

<BaseLayout
  description={entry.description ?? t("package.description", { name: entry.name })}
  githubLabel={links.github === undefined ? undefined : t("packages.card.github", { name: entry.name })}
  locale={locale}
  npmLabel={t("packages.card.npm", { name: entry.name })}
  siteConfig={packageHeaderConfig}
  title={entry.label}
>
  <main class="www-main" id="main-content">
    <div class="shell-content package-page">
      <a class="package-back" href={routing.localize("/packages/", locale)}>
        <i aria-hidden="true" class="ic-lucide-arrow-left"></i>{t("package.back")}
      </a>

      <header class="package-header">
        <div class="package-header-main">
          <div class="package-header-title">
            {entry.logoUrl !== undefined && <img alt="" class="package-logo" src={entry.logoUrl} />}
            <h1>{entry.label}</h1>
            {latest !== undefined && <span class="badge secondary soft">v{latest.version}</span>}
            {entry.status !== undefined && <StatusBadge labels={shellMessages(t).status} status={entry.status} />}
          </div>
          <div class="package-name">
            <code>{entry.name}</code>
            <CopyButton label={t("package.copyName")} locale={locale} text={entry.name} />
          </div>
        </div>
        {
          // Secondary links exist only beside a primary one, so this covers both.
          primaryLink !== undefined && (
            <nav aria-label={t("package.linksNav", { name: entry.label })} class="package-links">
              {
                secondaryLinks.map((link, index) => (
                  <span class="tooltip" data-tooltip-position="bottom">
                    <a
                      aria-labelledby={`package-link-tip-${index}`}
                      class="btn ghost edged icon sm"
                      href={link.href}
                      rel={link.external ? "noopener noreferrer" : undefined}
                      target={link.external ? "_blank" : undefined}
                    >
                      <Fragment set:html={link.icon} />
                    </a>
                    <span class="tooltip-bubble" id={`package-link-tip-${index}`} role="tooltip">
                      {link.label}
                    </span>
                  </span>
                ))
              }
              <a
                class="btn primary sm"
                href={primaryLink.href}
                rel={primaryLink.external ? "noopener noreferrer" : undefined}
                target={primaryLink.external ? "_blank" : undefined}
              >
                <Fragment set:html={primaryLink.icon} />
                {primaryLink.label}
              </a>
            </nav>
          )
        }
        {entry.description !== undefined && <p class="package-description">{entry.description}</p>}
      </header>

      <dl aria-label={t("package.facts.label")} class="package-facts">
        {
          facts.map(({ icon, term, value }) => (
            <div class="card soft edgeless p-sm">
              <dt>
                <Fragment set:html={icon} />
                {term}
              </dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>

      <section aria-labelledby="install-title" class="package-section">
        <h2 id="install-title">{t(properties.isCli ? "package.install.runTitle" : "package.install.title")}</h2>
        <InstallTabs isCli={properties.isCli} locale={locale} packageName={entry.name} />
      </section>

      <section aria-label={t("package.details")} class="package-section" data-package-tabs>
        <div aria-label={t("package.details")} class="www-tablist" role="tablist">
          {
            detailTabs.map(({ icon, id, label }, index) => (
              <button
                aria-controls={`package-panel-${id}`}
                aria-selected={index === 0 ? "true" : "false"}
                class="www-tab"
                id={`package-tab-${id}`}
                role="tab"
                tabindex={index === 0 ? 0 : -1}
                type="button"
              >
                <Fragment set:html={icon} />
                {label}
              </button>
            ))
          }
        </div>

        {
          readmeHtml !== undefined && (
            <div
              aria-labelledby="package-tab-readme"
              class="package-panel package-readme"
              id="package-panel-readme"
              lang={readme?.lang === locale ? undefined : readme?.lang}
              role="tabpanel"
              set:html={readmeHtml}
            />
          )
        }

        {
          entrypoints.length > 0 && (
            <div
              aria-labelledby="package-tab-entrypoints"
              class="package-panel"
              hidden={!isFirstTab("entrypoints")}
              id="package-panel-entrypoints"
              role="tabpanel"
            >
              <Entrypoints bundler={size?.bundler} locale={locale} packageName={entry.name} rows={entrypoints} />
            </div>
          )
        }

        <div
          aria-labelledby="package-tab-releases"
          class="package-panel"
          hidden={!isFirstTab("releases")}
          id="package-panel-releases"
          role="tabpanel"
        >
          {
            releases.history.length === 0 ? (
              <p class="package-note">{t("package.releases.none")}</p>
            ) : (
              <div class="package-table-wrap">
                <table class="package-table">
                  <thead>
                    <tr>
                      <th scope="col">{t("package.releases.version")}</th>
                      <th scope="col">{t("package.releases.published")}</th>
                      <th scope="col">
                        <span class="visually-hidden">{t("package.releases.actions")}</span>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {releases.history.map((release) => (
                      <tr>
                        <td>
                          <span class="package-release-version">
                            <code>{release.version}</code>
                            {release === latest && <span class="badge primary soft">{t("package.releases.latest")}</span>}
                            {release.isPrerelease && <span class="badge warning soft">{t("package.releases.prerelease")}</span>}
                          </span>
                        </td>
                        <td>
                          <time datetime={release.date}>{formatDate(release.date, locale)}</time>
                        </td>
                        <td>
                          <span class="package-release-actions">
                            <CopyButton
                              label={t(properties.isCli ? "package.releases.copyRun" : "package.releases.copyInstall", {
                                version: release.version,
                              })}
                              locale={locale}
                              text={packageCommand("npm", entry.name, properties.isCli, release.version)}
                            />
                            <a
                              aria-label={t("package.releases.download", { version: release.version })}
                              class="btn secondary ghost icon sm"
                              href={npmTarballUrl(entry.name, release.version)}
                              title={t("package.releases.download", { version: release.version })}
                            >
                              <i aria-hidden="true" class="ic-lucide-download" />
                            </a>
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )
          }
        </div>
        <noscript>
          <style>
            [data-package-tabs] [role="tablist"] {
              display: none;
            }
            .package-panel[hidden] {
              display: block;
            }
          </style>
        </noscript>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { bindTabs } from "../../../lib/tabs";

  for (const root of document.querySelectorAll<HTMLElement>("[data-package-tabs]")) {
    bindTabs(root);
  }

  // Escape dismisses a link's tooltip without moving the pointer or focus (WCAG 1.4.13).
  for (const tooltip of document.querySelectorAll<HTMLElement>(".package-links .tooltip")) {
    const reopen = (): void => tooltip.removeAttribute("data-state");
    tooltip.addEventListener("pointerleave", reopen);
    tooltip.addEventListener("focusout", reopen);
  }
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") {
      return;
    }
    for (const tooltip of document.querySelectorAll<HTMLElement>(
      ".package-links .tooltip:hover, .package-links .tooltip:focus-within",
    )) {
      tooltip.dataset.state = "closed";
    }
  });
</script>
