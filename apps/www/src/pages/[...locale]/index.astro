---
/**
 * The landing page: what CodenHub is and why its packages hold up. The package
 * groups and recent releases come from the catalog, so the page never names a
 * package or version that has not been released.
 */
import type { GetStaticPaths } from "astro";

import AsciiField from "../../components/ascii-field.astro";
import * as bookOpenIcon from "virtual:@codenhub/icons/lucide/book-open";
import * as gaugeIcon from "virtual:@codenhub/icons/lucide/gauge";
import * as globeIcon from "virtual:@codenhub/icons/lucide/globe";
import * as tagIcon from "virtual:@codenhub/icons/lucide/tag";
import { decorative } from "../../lib/icon";
import { getTranslator, localeStaticPaths, routing, type Locale } from "../../i18n";
import BaseLayout from "../../layouts/base-layout.astro";
import { catalogPackages } from "../../lib/catalog";
import { formatDate } from "../../lib/format";
import { headerConfig } from "../../site-config";
import "../../styles/global.css";
import "../../styles/landing.css";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = await getTranslator(locale);
const href = (path: string) => routing.localize(path, locale);

interface Area {
  title: string;
  body: string;
  /** Whether a package belongs here, by its slug. */
  includes: (slug: string) => boolean;
}

const named =
  (...slugs: string[]) =>
  (slug: string) =>
    slugs.includes(slug);

const areaCandidates: Area[] = [
  {
    title: t("home.areas.interface.title"),
    body: t("home.areas.interface.body"),
    includes: named("styles", "icons", "theme", "toaster", "kbd", "components", "ui-kit"),
  },
  {
    title: t("home.areas.application.title"),
    body: t("home.areas.application.body"),
    includes: named("router", "store", "i18n"),
  },
  {
    title: t("home.areas.trust.title"),
    body: t("home.areas.trust.body"),
    includes: named("validation", "error", "jwt", "oidc"),
  },
  {
    title: t("home.areas.tooling.title"),
    body: t("home.areas.tooling.body"),
    includes: (slug) => slug === "skills" || slug.startsWith("vite-plugin-") || slug.startsWith("tauri-plugin-"),
  },
];

const ungrouped = catalogPackages.filter((entry) => !areaCandidates.some((area) => area.includes(entry.slug)));

// An area shows only what has been released; a package no area names still
// gets listed, under "More", rather than silently missing from the page.
const areas = [
  ...areaCandidates.map((area) => ({ ...area, packages: catalogPackages.filter((entry) => area.includes(entry.slug)) })),
  { title: t("home.areas.more.title"), body: t("home.areas.more.body"), packages: ungrouped },
].filter((area) => area.packages.length > 0);

const recentReleases = catalogPackages
  .flatMap((entry) => (entry.releases.lastPublished === undefined ? [] : [{ entry, release: entry.releases.lastPublished }]))
  .sort((left, right) => Date.parse(right.release.date) - Date.parse(left.release.date))
  .slice(0, 6);

const principles = [
  {
    icon: decorative(globeIcon),
    title: t("home.principles.platform.title"),
    body: t("home.principles.platform.body"),
  },
  {
    icon: decorative(gaugeIcon),
    title: t("home.principles.measured.title"),
    body: t("home.principles.measured.body"),
  },
  {
    icon: decorative(bookOpenIcon),
    title: t("home.principles.documented.title"),
    body: t("home.principles.documented.body"),
  },
  {
    icon: decorative(tagIcon),
    title: t("home.principles.published.title"),
    body: t("home.principles.published.body"),
  },
];
---

<BaseLayout locale={locale} overlayHeader siteConfig={headerConfig}>
  <main class="landing" id="main-content">
    <section aria-labelledby="landing-title" class="landing-hero">
      <AsciiField class="landing-hero-field" />
      <div class="shell-content landing-hero-content">
        <div class="landing-hero-copy">
          <h1 class="landing-display" id="landing-title">
            {t("home.hero.title")}<br />{t("home.hero.titleEnd")}
          </h1>
          <p class="landing-lede">{t("home.hero.lede")}</p>
          <div class="landing-actions">
            <a class="btn primary landing-cta" href={href("/packages/")}>
              {t("home.browse")}
              <i aria-hidden="true" class="ic-lucide-arrow-right"></i>
            </a>
            <button class="btn ghost edged landing-cta" data-open-search type="button">
              <i aria-hidden="true" class="ic-lucide-search"></i>
              {t("home.searchDocs")}
            </button>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="principles-title" class="landing-section landing-band">
      <div class="shell-content">
        <h2 class="landing-heading" id="principles-title">
          {t("home.principles.title")}<br />{t("home.principles.titleEnd")}
        </h2>
        <ul class="landing-principles">
          {
            principles.map((principle) => (
              <li class="landing-principle">
                <span aria-hidden="true" class="landing-principle-icon">
                  <Fragment set:html={principle.icon} />
                </span>
                <h3>{principle.title}</h3>
                <p>{principle.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section aria-labelledby="areas-title" class="landing-section">
      <div class="shell-content">
        <h2 class="landing-heading" id="areas-title">
          {t("home.areas.title")}<br />{t("home.areas.titleEnd")}
        </h2>
        <div class="landing-areas">
          {
            areas.map((area) => (
              <article class="landing-area">
                <h3>{area.title}</h3>
                <p>{area.body}</p>
                <ul class="landing-area-packages">
                  {area.packages.map((entry) => (
                    <li>
                      <a href={href(`/packages/${entry.slug}/`)} title={entry.description}>
                        {entry.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {
      recentReleases.length > 0 && (
        <section aria-labelledby="releases-title" class="landing-section landing-band">
          <div class="shell-content landing-releases">
            <div class="landing-releases-intro">
              <h2 class="landing-heading" id="releases-title">
                {t("home.releases.title")}
                <br />
                {t("home.releases.titleEnd")}
              </h2>
              <a class="landing-link" href={href("/packages/")}>
                {t("home.releases.all")}
                <i aria-hidden="true" class="ic-lucide-arrow-right" />
              </a>
            </div>
            <ol class="landing-release-list">
              {recentReleases.map(({ entry, release }) => (
                <li>
                  <a class="landing-release" href={href(`/packages/${entry.slug}/`)}>
                    <span class="landing-release-label">{entry.label}</span>
                    <span class="landing-release-name">{entry.name}</span>
                    <span class="landing-release-version">v{release.version}</span>
                    <time class="landing-release-date" datetime={release.date}>
                      {formatDate(release.date, locale)}
                    </time>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <section aria-labelledby="cta-title" class="landing-closing">
      <div class="shell-content landing-closing-content">
        <h2 class="landing-display" id="cta-title">{t("home.closing.title")}</h2>
        <p>{t("home.closing.body")}</p>
        <div class="landing-actions">
          <a class="btn primary landing-cta" href={href("/packages/")}>
            {t("home.browse")}
            <i aria-hidden="true" class="ic-lucide-arrow-right"></i>
          </a>
          <button class="btn ghost edged landing-cta" data-open-search type="button">
            <i aria-hidden="true" class="ic-lucide-search"></i>
            {t("home.searchDocs")}
            <kbd class="kbd landing-cta-kbd" data-landing-shortcut>Ctrl + K</kbd>
          </button>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // The palette owns its own trigger in the header; these buttons open it the
  // same way, so there is one dialog and one keyboard shortcut.
  const trigger = document.querySelector<HTMLButtonElement>("[data-search-trigger]");
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-open-search]")) {
    button.addEventListener("click", () => trigger?.click());
  }

  const shortcut = document.querySelector<HTMLElement>("[data-landing-shortcut]");
  if (shortcut !== null && navigator.platform.toUpperCase().includes("MAC")) {
    shortcut.textContent = "⌘ + K";
  }
</script>
