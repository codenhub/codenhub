---
import BaseLayout from "@codenhub/app-shell/layouts/base-layout.astro";

import BrandIcon from "../components/brand-icon.astro";
import PackageCard from "../components/package-card.astro";
import { catalogPackages } from "../lib/catalog";
import { siteConfig } from "../site-config";
import "../styles/global.css";

interface Route {
  href: string | undefined;
  title: string;
  body: string;
  external: boolean;
  /** Leading lucide icon class for an internal surface. */
  icon?: string;
  /** Leading inline brand mark, for GitHub and npm. */
  brand?: "github" | "npm";
}

const routes: Route[] = [
  { href: siteConfig.docsUrl, title: "Documentation", body: "Guides, API reference, and changelogs for every package.", external: false, icon: "ic-lucide-book-open" },
  { href: siteConfig.demoUrl, title: "Demos", body: "Live, deployed demos for the packages that ship one.", external: false, icon: "ic-lucide-play" },
  { href: siteConfig.githubUrl, title: "GitHub", body: "Source, issues, and the monorepo itself.", external: true, brand: "github" },
  { href: siteConfig.npmUrl, title: "npm", body: "The @codenhub organization and its published packages.", external: true, brand: "npm" },
];

const visibleRoutes = routes.filter((route): route is Route & { href: string } => route.href !== undefined);
---

<BaseLayout siteConfig={siteConfig}>
  <main class="www-main" id="main-content">
    <div class="shell-content">
      <section class="www-hero">
        <h1>CodenHub</h1>
        <p>
          The shared packages, apps, and project standards behind <a href="https://coden.agency/">coden.agency</a>. This
          is the index — every package, with its version, size, and links to its documentation, demo, source, and npm
          release.
        </p>
      </section>

      <nav aria-label="CodenHub surfaces" class="www-routes">
        {
          visibleRoutes.map((route) => (
            <a
              class="www-route"
              href={route.href}
              rel={route.external ? "noopener noreferrer" : undefined}
              target={route.external ? "_blank" : undefined}
            >
              <span class="www-route-title">
                {route.brand !== undefined && <BrandIcon brand={route.brand} class="www-route-icon www-route-brand" />}
                {route.icon !== undefined && <i aria-hidden="true" class:list={["www-route-icon", route.icon]} />}
                {route.title}
                <i aria-hidden="true" class="www-route-arrow ic-lucide-arrow-up-right" />
              </span>
              <p>{route.body}</p>
            </a>
          ))
        }
      </nav>

      <section aria-labelledby="packages-title">
        <div class="packages-toolbar">
          <div>
            <h2 id="packages-title">Packages</h2>
          </div>
          <div class="packages-toolbar-controls">
            <div class="input-group package-search">
              <i aria-hidden="true" class="ic-lucide-search"></i>
              <input aria-label="Search packages" id="package-search" placeholder="Search packages…" type="search" />
            </div>
            <button
              aria-label="Sort by name, ascending"
              aria-pressed="false"
              class="package-sort"
              data-sort-direction="asc"
              id="package-sort"
              title="Sort by name, ascending"
              type="button"
            >
              <i aria-hidden="true" class="ic-lucide-arrow-down-a-z" data-sort-icon="asc"></i>
              <i aria-hidden="true" class="ic-lucide-arrow-down-z-a" data-sort-icon="desc" hidden></i>
            </button>
          </div>
        </div>

        <div class="package-grid" id="package-grid" role="list">
          {catalogPackages.map((entry) => <PackageCard entry={entry} />)}
        </div>
        <p class="packages-empty" data-empty-filtered hidden>No packages match your search.</p>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { initPackageGrid } from "@codenhub/app-shell/package-grid";

  initPackageGrid();
</script>
