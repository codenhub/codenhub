{
  "name": "@codenhub/www",
  "version": "0.0.1",
  "private": true,
  "description": "The CodenHub site: landing page, package list and package pages, and search across the docs.",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "wrangler dev",
    "preview:deploy": "wrangler versions upload",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/markdown-remark": "catalog:",
    "@codenhub/app-shell": "workspace:*",
    "@codenhub/icons": "workspace:*",
    "@codenhub/styles": "workspace:*",
    "@codenhub/tools": "workspace:*",
    "@types/node": "catalog:",
    "astro": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "codenhub": {
    "assets": [
      {
        "from": "favicon/favicon.ico",
        "to": "public/favicon.ico"
      },
      {
        "from": "logo/logo-dark.svg",
        "to": "public/assets/logo/logo-dark.svg"
      },
      {
        "from": "logo/logo-light.svg",
        "to": "public/assets/logo/logo-light.svg"
      },
      {
        "from": "fonts/monomaniac-one/MonomaniacOne-Regular.woff2",
        "to": "public/assets/fonts/monomaniac-one/MonomaniacOne-Regular.woff2"
      },
      {
        "from": "fonts/monomaniac-one/MonomaniacOne-Regular.woff",
        "to": "public/assets/fonts/monomaniac-one/MonomaniacOne-Regular.woff"
      }
    ]
  }
}
