{
  "name": "@codenhub/docs",
  "version": "0.0.1",
  "private": true,
  "description": "Documentation site that publishes every package README, public docs, and assets.",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@codenhub/kbd": "workspace:*",
    "@codenhub/styles": "workspace:*",
    "@codenhub/tools": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "astro": "7.0.7",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
