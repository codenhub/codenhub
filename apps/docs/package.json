{
  "name": "@codenhub/docs",
  "version": "0.0.1",
  "private": true,
  "description": "Documentation site that publishes every package README, public docs, and assets.",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "wrangler dev",
    "preview:deploy": "wrangler versions upload",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:watch": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "astro check"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/markdown-remark": "catalog:",
    "@codenhub/app-shell": "workspace:*",
    "@codenhub/icons": "workspace:*",
    "@codenhub/styles": "workspace:*",
    "@codenhub/tools": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "astro": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "codenhub": {
    "assets": [
      {
        "from": "favicon/favicon.ico",
        "to": "public/favicon.ico"
      },
      {
        "from": "logo/logo-dark.svg",
        "to": "public/assets/logo/logo-dark.svg"
      },
      {
        "from": "logo/logo-light.svg",
        "to": "public/assets/logo/logo-light.svg"
      }
    ]
  }
}
