# codenhub.dev hosts the shared search palette and fetches each language's
# index from here. The index is public documentation text, so any origin may
# read it.
/search-index.json
  Access-Control-Allow-Origin: *

/:locale/search-index.json
  Access-Control-Allow-Origin: *

# Each page's Markdown source (`<route>/index.md`). The charset keeps non-ASCII
# text readable when a browser opens the file directly. It also labels the 404
# for a missing `.md` path; `apps/docs/AGENTS.md` records why it stays.
/*.md
  Content-Type: text/markdown; charset=utf-8
