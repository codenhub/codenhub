---
import type { SiteConfig } from "@codenhub/app-shell/site-config";
import ShellLayout from "@codenhub/app-shell/layouts/base-layout.astro";
import LanguageMenu from "@codenhub/app-shell/components/language-menu.astro";
import LocaleRedirect from "@codenhub/app-shell/components/locale-redirect.astro";
import SearchPalette from "@codenhub/app-shell/components/search-palette.astro";

import { defaultLocale, localeNames, locales, localizePath, messagesFor, type Locale } from "../i18n";
import type { PageAlternate, PublicPackage } from "../lib/catalog";
import { siteConfig } from "../site-config";
import "../styles/global.css";

interface Props {
  /** Every language version of the page, itself included, and `x-default`, named in `hreflang` alternates. */
  alternates?: readonly PageAlternate[];
  description?: string;
  /**
   * The English page's route, for a page that exists in every locale: the
   * language menu lists it in each, and an English page redirects a reader
   * who chose another language there.
   */
  englishRoute?: string;
  /** The page's language, which sets `<html lang>`, the interface text, and the search index. */
  locale?: Locale;
  sectionTitle?: string;
  title?: string;
  /** Whether the page shows an English body under a locale prefix, which names the English page as canonical. */
  untranslated?: boolean;
  /** Whether search engines should leave the page out, as for an archived version's page. */
  noindex?: boolean;
  /**
   * The package this page belongs to, when it is package-scoped. Scopes the
   * header's npm and GitHub links to this package. A package's demo is linked
   * from its sidebar tabs, not the header.
   */
  currentPackage?: Pick<PublicPackage, "githubLabel" | "githubUrl" | "npmLabel" | "npmUrl">;
}

const {
  alternates = [],
  currentPackage,
  description,
  englishRoute,
  locale = defaultLocale,
  noindex = false,
  sectionTitle,
  title,
  untranslated = false,
} = Astro.props;
const messages = messagesFor(locale);
// The main site has every page in every locale, so its links keep the reader's language.
const wwwPath = (path: string): string => `${siteConfig.wwwUrl}${localizePath(locale, path)}`;

/*
 * The header reads as part of codenhub.dev: the logo goes to its home and the
 * one nav link to its package list, as on that site, so no cross-surface links
 * (CodenHub, Documentation, Demo) are shown.
 */
const scopedSiteConfig: SiteConfig = {
  ...siteConfig,
  demoUrl: undefined,
  docsUrl: undefined,
  githubUrl: currentPackage?.githubUrl ?? siteConfig.githubUrl,
  npmUrl: currentPackage?.npmUrl ?? siteConfig.npmUrl,
  wwwUrl: undefined,
};
const homeHref = wwwPath("/");
// The page in every language, in the site's locale order, as on the main site.
const languageOptions =
  englishRoute === undefined
    ? []
    : locales.map((target) => ({ locale: target, href: localizePath(target, englishRoute), name: localeNames[target] }));
// This page in every other locale, for the redirect on English pages.
const redirectTargets = Object.fromEntries(
  languageOptions.filter((option) => option.locale !== defaultLocale).map((option) => [option.locale, option.href]),
);
const localLinks = [{ href: wwwPath("/packages/"), label: messages.packages }];
---

<ShellLayout
  description={description}
  githubLabel={currentPackage?.githubLabel}
  homeHref={homeHref}
  lang={locale}
  localLinks={localLinks}
  messages={messages.shell}
  npmLabel={currentPackage?.npmLabel}
  sectionTitle={sectionTitle}
  siteConfig={scopedSiteConfig}
  title={title}
>
  {locale === defaultLocale && englishRoute !== undefined && <LocaleRedirect slot="head" targets={redirectTargets} />}
  {noindex && <meta content="noindex" name="robots" slot="head" />}
  {
    untranslated && englishRoute !== undefined && (
      <link href={new URL(englishRoute, siteConfig.siteUrl).href} rel="canonical" slot="head" />
    )
  }
  {
    alternates.map((alternate) => (
      <link
        href={new URL(alternate.route, siteConfig.siteUrl).href}
        hreflang={alternate.lang}
        rel="alternate"
        slot="head"
      />
    ))
  }
  <SearchPalette indexUrl={localizePath(locale, "/search-index.json")} messages={messages.shell.search} slot="actions" />
  {
    languageOptions.length > 0 && (
      <LanguageMenu label={messages.language} locale={locale} options={languageOptions} slot="actions" />
    )
  }
  <slot />
  <script>
    import { createCopyController } from "@codenhub/app-shell/copy-feedback";

    import { findCodeCopyStatus } from "../lib/markdown/code-copy";

    const copyController = createCopyController();

    if (document.documentElement.dataset.codeCopyReady !== "true") {
      document.documentElement.dataset.codeCopyReady = "true";
      document.addEventListener("click", async (event) => {
        const target = event.target;
        const copyButton =
          target instanceof Element ? target.closest<HTMLButtonElement>("[data-code-copy]") : null;
        if (copyButton === null) {
          return;
        }

        const code = copyButton.closest(".code-block")?.querySelector("code")?.textContent;
        if (code === undefined) {
          return;
        }

        const status = findCodeCopyStatus(copyButton);
        if (status === null) {
          return;
        }

        await copyController.copy({ button: copyButton, clipboard: navigator.clipboard, status, text: code });
      });
    }
  </script>
</ShellLayout>
