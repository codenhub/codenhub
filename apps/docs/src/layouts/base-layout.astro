---
import type { SiteConfig } from "@codenhub/app-shell/site-config";
import ShellLayout from "@codenhub/app-shell/layouts/base-layout.astro";

import SearchPalette from "../components/search-palette.astro";
import type { PublicPackage } from "../lib/catalog";
import { siteConfig } from "../site-config";
import "../styles/global.css";

interface Props {
  description?: string;
  sectionTitle?: string;
  title?: string;
  /**
   * The package this page belongs to, when it is package-scoped. Scopes the
   * header's Demo, npm, and GitHub links to this package instead of the site
   * root; "Documentation" is already omitted everywhere on this site, since
   * every page here already is documentation.
   */
  currentPackage?: Pick<PublicPackage, "demoUrl" | "githubLabel" | "githubUrl" | "npmLabel" | "npmUrl">;
}

const { currentPackage, description, sectionTitle, title } = Astro.props;

const scopedSiteConfig: SiteConfig =
  currentPackage === undefined
    ? siteConfig
    : {
        ...siteConfig,
        demoUrl: currentPackage.demoUrl,
        githubUrl: currentPackage.githubUrl ?? siteConfig.githubUrl,
        npmUrl: currentPackage.npmUrl ?? siteConfig.npmUrl,
      };
---

<ShellLayout
  description={description}
  githubLabel={currentPackage?.githubLabel}
  npmLabel={currentPackage?.npmLabel}
  sectionTitle={sectionTitle}
  siteConfig={scopedSiteConfig}
  title={title}
>
  <SearchPalette slot="actions" />
  <slot />
  <script>
    import { createCodeCopyController, findCodeCopyStatus } from "../lib/markdown/code-copy";

    const copyController = createCodeCopyController();

    if (document.documentElement.dataset.codeCopyReady !== "true") {
      document.documentElement.dataset.codeCopyReady = "true";
      document.addEventListener("click", async (event) => {
        const target = event.target;
        const copyButton =
          target instanceof Element ? target.closest<HTMLButtonElement>("[data-code-copy]") : null;
        if (copyButton === null) {
          return;
        }

        const code = copyButton.closest(".code-block")?.querySelector("code")?.textContent;
        if (code === undefined) {
          return;
        }

        const status = findCodeCopyStatus(copyButton);
        if (status === null) {
          return;
        }

        await copyController.copy({ button: copyButton, clipboard: navigator.clipboard, code, status });
      });
    }
  </script>
</ShellLayout>
