---
import ShellLayout from "@codenhub/app-shell/layouts/base-layout.astro";

import SearchPalette from "../components/search-palette.astro";
import { siteConfig } from "../site-config";
import "../styles/global.css";

interface Props {
  description?: string;
  sectionTitle?: string;
  title?: string;
}

const { description, sectionTitle, title } = Astro.props;
---

<ShellLayout description={description} sectionTitle={sectionTitle} siteConfig={siteConfig} title={title}>
  <SearchPalette slot="actions" />
  <slot />
  <script>
    import { createCodeCopyController, findCodeCopyStatus } from "../lib/markdown/code-copy";

    const copyController = createCodeCopyController();

    if (document.documentElement.dataset.codeCopyReady !== "true") {
      document.documentElement.dataset.codeCopyReady = "true";
      document.addEventListener("click", async (event) => {
        const target = event.target;
        const copyButton =
          target instanceof Element ? target.closest<HTMLButtonElement>("[data-code-copy]") : null;
        if (copyButton === null) {
          return;
        }

        const code = copyButton.closest(".code-block")?.querySelector("code")?.textContent;
        if (code === undefined) {
          return;
        }

        const status = findCodeCopyStatus(copyButton);
        if (status === null) {
          return;
        }

        await copyController.copy({ button: copyButton, clipboard: navigator.clipboard, code, status });
      });
    }
  </script>
</ShellLayout>
