---
import type { SiteConfig } from "@codenhub/app-shell/site-config";
import ShellLayout from "@codenhub/app-shell/layouts/base-layout.astro";
import SearchPalette from "@codenhub/app-shell/components/search-palette.astro";

import type { PublicPackage } from "../lib/catalog";
import { siteConfig } from "../site-config";
import "../styles/global.css";

interface Props {
  description?: string;
  sectionTitle?: string;
  title?: string;
  /**
   * The package this page belongs to, when it is package-scoped. Scopes the
   * header's npm and GitHub links to this package. A package's demo is linked
   * from its sidebar tabs, not the header.
   */
  currentPackage?: Pick<PublicPackage, "githubLabel" | "githubUrl" | "npmLabel" | "npmUrl">;
}

const { currentPackage, description, sectionTitle, title } = Astro.props;

/*
 * The header reads as part of codenhub.dev: the logo goes to its home and the
 * one nav link to its package list, as on that site, so no cross-surface links
 * (CodenHub, Documentation, Demo) are shown.
 */
const scopedSiteConfig: SiteConfig = {
  ...siteConfig,
  demoUrl: undefined,
  docsUrl: undefined,
  githubUrl: currentPackage?.githubUrl ?? siteConfig.githubUrl,
  npmUrl: currentPackage?.npmUrl ?? siteConfig.npmUrl,
  wwwUrl: undefined,
};
const homeHref = `${siteConfig.wwwUrl}/`;
const localLinks = [{ href: `${siteConfig.wwwUrl}/packages/`, label: "Packages" }];
---

<ShellLayout
  description={description}
  githubLabel={currentPackage?.githubLabel}
  homeHref={homeHref}
  localLinks={localLinks}
  npmLabel={currentPackage?.npmLabel}
  sectionTitle={sectionTitle}
  siteConfig={scopedSiteConfig}
  title={title}
>
  <SearchPalette indexUrl="/search-index.json" slot="actions" />
  <slot />
  <script>
    import { createCopyController } from "@codenhub/app-shell/copy-feedback";

    import { findCodeCopyStatus } from "../lib/markdown/code-copy";

    const copyController = createCopyController();

    if (document.documentElement.dataset.codeCopyReady !== "true") {
      document.documentElement.dataset.codeCopyReady = "true";
      document.addEventListener("click", async (event) => {
        const target = event.target;
        const copyButton =
          target instanceof Element ? target.closest<HTMLButtonElement>("[data-code-copy]") : null;
        if (copyButton === null) {
          return;
        }

        const code = copyButton.closest(".code-block")?.querySelector("code")?.textContent;
        if (code === undefined) {
          return;
        }

        const status = findCodeCopyStatus(copyButton);
        if (status === null) {
          return;
        }

        await copyController.copy({ button: copyButton, clipboard: navigator.clipboard, status, text: code });
      });
    }
  </script>
</ShellLayout>
