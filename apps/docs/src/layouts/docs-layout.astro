---
import BackToTop from "../components/back-to-top.astro";
import LinkPreview from "../components/link-preview.astro";
import PageActions from "../components/page-actions.astro";
import PageOutline from "../components/page-outline.astro";
import PackageNavigation from "../components/package-navigation.astro";
import { defaultLocale, messagesFor, type Locale } from "../i18n";
import { fillMessage } from "@codenhub/app-shell/messages";

import { isReferenceDocument, versionRoute, type PublicDocument, type PublicPackage } from "../lib/catalog";
import BaseLayout from "./base-layout.astro";

interface Props {
  currentPackage: PublicPackage;
  document: PublicDocument;
  /** The page's language: the document's own, or English for an English page. */
  locale?: Locale;
}

const { currentPackage, document, locale = defaultLocale } = Astro.props;
const messages = messagesFor(locale);
const tocHeadings = document.headings.filter(({ depth }) => depth === 2 || depth === 3);

// A generated reference page carries a terse sidebar title (`/`, `/registries`)
// and puts the full import specifier in its H1, so the browser title reads from
// the heading. Its `description`/`since` deck is spliced below the H1 in the
// catalog, not rendered here.
const headingTitle = document.headings.find(({ depth }) => depth === 1)?.text;
const browserTitle =
  isReferenceDocument(document) && headingTitle !== undefined ? headingTitle : document.title;
// An English body under a locale prefix (`docs/specs/packages-translations.md`, "Documentation site").
const untranslated = document.lang !== locale;
const { englishFragments } = document;
// An archived version's notice links the same page in the current version
// (`docs/specs/packages-docs-versions.md`, "Presentation").
const { archivedVersion } = currentPackage;
const currentVersion = currentPackage.versions.find(({ current }) => current);
const currentVersionRoute =
  archivedVersion === undefined || currentVersion === undefined
    ? undefined
    : versionRoute(currentVersion, document.routePath, locale);
---

<BaseLayout
  alternates={document.alternates}
  currentPackage={currentPackage}
  description={document.description ?? currentPackage.description}
  englishRoute={document.englishRoute}
  locale={locale}
  noindex={archivedVersion !== undefined}
  sectionTitle={currentPackage.label}
  title={browserTitle}
  untranslated={untranslated}
>
  <details class="mobile-navigation">
    <summary>{messages.browse}</summary>
    <div class="mobile-navigation-panel">
      <PackageNavigation
        currentPackage={currentPackage}
        currentRoute={document.route}
        locale={locale}
        routePath={document.routePath}
      />
    </div>
  </details>

  <div class="docs-shell section-content wide">
    <aside class="left-rail">
      <PackageNavigation
        currentPackage={currentPackage}
        currentRoute={document.route}
        locale={locale}
        routePath={document.routePath}
      />
    </aside>

    <main class="document-column" id="main-content">
      <div class="document-body">
        {tocHeadings.length > 0 && <PageOutline headings={tocHeadings} label={messages.onThisPage} />}
        <PageActions locale={locale} route={document.route} />
        {
          archivedVersion !== undefined && (
            <p class="archived-notice" role="note">
              <i aria-hidden="true" class="ic-lucide-history" />
              <span>
                {fillMessage(messages.versions.archived, { version: archivedVersion })}{" "}
                {currentVersionRoute !== undefined && <a href={currentVersionRoute}>{messages.versions.readCurrent}</a>}
              </span>
            </p>
          )
        }
        {
          untranslated && (
            <p class="untranslated-notice" role="note">
              <i aria-hidden="true" class="ic-lucide-languages" />
              {messages.untranslated}
            </p>
          )
        }
        <article class="markdown-content" lang={untranslated ? document.lang : undefined}>
          <slot />
        </article>
        {
          englishFragments !== undefined && Object.keys(englishFragments).length > 0 && (
            <script define:vars={{ englishFragments }} is:inline>
              // An English section link, such as one the locale redirect kept,
              // moves to the translated section (`translated-fragments.ts`).
              // Inline, right after the body, so it runs before the page settles.
              const englishId = (() => {
                try {
                  return decodeURIComponent(location.hash.slice(1));
                } catch {
                  return "";
                }
              })();
              if (Object.hasOwn(englishFragments, englishId) && document.getElementById(englishId) === null) {
                location.replace("#" + encodeURIComponent(englishFragments[englishId]));
              }
            </script>
          )
        }
      </div>
    </main>

    <aside class="toc-rail">
      {
        tocHeadings.length > 0 && (
          <nav aria-label={messages.onThisPage} data-toc>
            <p class="rail-title">{messages.onThisPage}</p>
            <ol>
              {tocHeadings.map((heading) => (
                <li class:list={{ nested: heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>
  </div>

  <BackToTop label={messages.backToTop} />
  <LinkPreview locale={locale} />

  <script>
    import { createTocRevealer, findActiveHeadingId } from "../lib/toc-highlight";

    const toc = document.querySelector<HTMLElement>("[data-toc]");

    if (toc !== null) {
      const revealActiveLink = createTocRevealer(toc);
      const links = [...toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
      const entries = links.flatMap((link) => {
        const id = decodeURIComponent(link.hash.slice(1));
        const heading = document.getElementById(id);

        return heading === null ? [] : [{ heading, id, link }];
      });

      // The page is the scroll container at every breakpoint, and `html` already
      // reserves the sticky header through `scroll-padding-top`. Reusing that
      // value as the activation line makes following a link and reading past a
      // heading agree on which entry is current.
      const readActivationOffset = () => {
        const padding = Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop);

        return Number.isNaN(padding) ? 0 : padding;
      };

      const update = () => {
        const activeId = findActiveHeadingId({
          headings: entries.map(({ heading, id }) => ({
            id,
            top: heading.getBoundingClientRect().top + window.scrollY,
          })),
          offset: readActivationOffset(),
          scrollHeight: document.documentElement.scrollHeight,
          scrollTop: window.scrollY,
          viewportHeight: window.innerHeight,
        });

        for (const { id, link } of entries) {
          if (id === activeId) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        }

        revealActiveLink(entries.find(({ id }) => id === activeId)?.link);
      };

      let queued = false;
      const scheduleUpdate = () => {
        if (queued) {
          return;
        }

        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      };

      update();
      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate, { passive: true });
    }
  </script>
</BaseLayout>
