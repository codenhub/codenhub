---
import BackToTop from "../components/back-to-top.astro";
import LinkPreview from "../components/link-preview.astro";
import PageActions from "../components/page-actions.astro";
import PageOutline from "../components/page-outline.astro";
import PackageNavigation from "../components/package-navigation.astro";
import { isReferenceDocument, type PublicDocument, type PublicPackage } from "../lib/catalog";
import BaseLayout from "./base-layout.astro";

interface Props {
  currentPackage: PublicPackage;
  document: PublicDocument;
}

const { currentPackage, document } = Astro.props;
const tocHeadings = document.headings.filter(({ depth }) => depth === 2 || depth === 3);

// A generated reference page carries a terse sidebar title (`/`, `/registries`)
// and puts the full import specifier in its H1, so the browser title reads from
// the heading. Its `description`/`since` deck is spliced below the H1 in the
// catalog, not rendered here.
const headingTitle = document.headings.find(({ depth }) => depth === 1)?.text;
const browserTitle =
  isReferenceDocument(document) && headingTitle !== undefined ? headingTitle : document.title;
---

<BaseLayout
  currentPackage={currentPackage}
  description={document.description ?? currentPackage.description}
  sectionTitle={currentPackage.label}
  title={browserTitle}
>
  <details class="mobile-navigation">
    <summary>Browse documentation</summary>
    <div class="mobile-navigation-panel">
      <PackageNavigation currentPackage={currentPackage} currentRoute={document.route} />
    </div>
  </details>

  <div class="docs-shell section-content wide">
    <aside class="left-rail">
      <PackageNavigation currentPackage={currentPackage} currentRoute={document.route} />
    </aside>

    <main class="document-column" id="main-content">
      <div class="document-body">
        {tocHeadings.length > 0 && <PageOutline headings={tocHeadings} />}
        <PageActions route={document.route} />
        <article class="markdown-content">
          <slot />
        </article>
      </div>
    </main>

    <aside class="toc-rail">
      {
        tocHeadings.length > 0 && (
          <nav aria-label="On this page" data-toc>
            <p class="rail-title">On this page</p>
            <ol>
              {tocHeadings.map((heading) => (
                <li class:list={{ nested: heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>
  </div>

  <BackToTop />
  <LinkPreview />

  <script>
    import { createTocRevealer, findActiveHeadingId } from "../lib/toc-highlight";

    const toc = document.querySelector<HTMLElement>("[data-toc]");

    if (toc !== null) {
      const revealActiveLink = createTocRevealer(toc);
      const links = [...toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
      const entries = links.flatMap((link) => {
        const id = decodeURIComponent(link.hash.slice(1));
        const heading = document.getElementById(id);

        return heading === null ? [] : [{ heading, id, link }];
      });

      // The page is the scroll container at every breakpoint, and `html` already
      // reserves the sticky header through `scroll-padding-top`. Reusing that
      // value as the activation line makes following a link and reading past a
      // heading agree on which entry is current.
      const readActivationOffset = () => {
        const padding = Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop);

        return Number.isNaN(padding) ? 0 : padding;
      };

      const update = () => {
        const activeId = findActiveHeadingId({
          headings: entries.map(({ heading, id }) => ({
            id,
            top: heading.getBoundingClientRect().top + window.scrollY,
          })),
          offset: readActivationOffset(),
          scrollHeight: document.documentElement.scrollHeight,
          scrollTop: window.scrollY,
          viewportHeight: window.innerHeight,
        });

        for (const { id, link } of entries) {
          if (id === activeId) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        }

        revealActiveLink(entries.find(({ id }) => id === activeId)?.link);
      };

      let queued = false;
      const scheduleUpdate = () => {
        if (queued) {
          return;
        }

        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      };

      update();
      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate, { passive: true });
    }
  </script>
</BaseLayout>
