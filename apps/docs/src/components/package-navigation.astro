---
import StatusBadge from "@codenhub/app-shell/components/status-badge.astro";
import { fillMessage } from "@codenhub/app-shell/messages";

import { messagesFor, type Locale } from "../i18n";
import { navigationDocuments, type PublicPackage } from "../lib/catalog";
import { buildPackageSidebar, groupContainsRoute, type NavLink } from "../lib/package-navigation";

interface Props {
  currentPackage: PublicPackage;
  currentRoute?: string;
  /** The page's language, which picks the navigation list and its labels. */
  locale?: Locale;
}

const { currentPackage, currentRoute, locale = "en" } = Astro.props;
const messages = messagesFor(locale);
const { tabs, tree } = buildPackageSidebar(
  navigationDocuments(currentPackage, locale),
  currentRoute,
  messages.sections,
  messages.overview,
);

const { demoUrl } = currentPackage;

// A strip of one is not a choice, so a package with a single section and no
// demo shows none.
const sectionTabs = tabs.length + (demoUrl === undefined ? 0 : 1) > 1 ? tabs : [];

// In a locale, an untranslated page links to its English route and says so
// (`docs/specs/packages-translations.md`, "Documentation site").
const isEnglishFallback = (link: NavLink): boolean => link.lang !== locale;
---

<nav aria-label={fillMessage(messages.packageNavigation, { label: currentPackage.label })}>
  <div class="package-navigation-title">
    <p class="rail-title">{currentPackage.label}</p>
    <StatusBadge labels={messages.shell.status} status={currentPackage.status} />
  </div>

  {
    sectionTabs.length > 0 && (
      <ul class="package-tabs">
        {sectionTabs.map((tab) => (
          <li>
            <a class="package-tab" aria-current={tab.current ? "location" : undefined} href={tab.route}>
              {/* One literal tag per section: the icons plugin's svg mode only
                  rewrites an `<i>` whose class is written out in full. */}
              {tab.id === "guides" && <i aria-hidden="true" class="ic-lucide-book package-tab-icon" />}
              {tab.id === "reference" && <i aria-hidden="true" class="ic-lucide-code package-tab-icon" />}
              {tab.id === "changelog" && <i aria-hidden="true" class="ic-lucide-tag package-tab-icon" />}
              {tab.label}
            </a>
          </li>
        ))}
        {demoUrl !== undefined && (
          <li>
            {/* The demo is another site, so like the shell's cross-surface links it
                opens in a new tab and carries the outbound arrow. */}
            <a class="package-tab" href={demoUrl} rel="noopener noreferrer" target="_blank">
              <i aria-hidden="true" class="ic-lucide-monitor-play package-tab-icon" />
              {messages.demo}
              <i aria-hidden="true" class="ic-lucide-arrow-up-right package-tab-outbound" />
            </a>
          </li>
        )}
      </ul>
    )
  }

  <ul class="document-list">
    {
      tree.map((node) =>
        node.kind === "link" ? (
          <li>
            <a
              aria-current={node.route === currentRoute ? "page" : undefined}
              href={node.route}
              hreflang={isEnglishFallback(node) ? "en" : undefined}
            >
              {isEnglishFallback(node) ? <span lang="en">{node.title}</span> : node.title}
              {isEnglishFallback(node) && <span class="nav-language">({messages.inEnglish})</span>}
            </a>
          </li>
        ) : (
          <li>
            <details class="nav-group" open={groupContainsRoute(node, currentRoute)}>
              <summary>
                {node.title}
                <svg aria-hidden="true" class="nav-group-caret" viewBox="0 0 24 24">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </summary>
              <ul class="document-sublist">
                {node.items.map((item) => (
                  <li>
                    <a
                      aria-current={item.route === currentRoute ? "page" : undefined}
                      href={item.route}
                      hreflang={isEnglishFallback(item) ? "en" : undefined}
                    >
                      {isEnglishFallback(item) ? <span lang="en">{item.title}</span> : item.title}
                      {isEnglishFallback(item) && <span class="nav-language">({messages.inEnglish})</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ),
      )
    }
  </ul>
</nav>
