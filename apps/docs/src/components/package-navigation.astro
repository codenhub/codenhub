---
import type { PublicPackage } from "../lib/catalog";
import { buildNavigationTree, groupContainsRoute } from "../lib/package-navigation";
import StatusBadge from "./status-badge.astro";

interface Props {
  currentPackage: PublicPackage;
  currentRoute?: string;
}

const { currentPackage, currentRoute } = Astro.props;
const navigation = buildNavigationTree(currentPackage.documents);
---

<nav aria-label={`${currentPackage.label} documentation`}>
  <div class="package-navigation-title">
    <p class="rail-title">{currentPackage.label}</p>
    <StatusBadge status={currentPackage.status} />
  </div>
  <ul class="document-list">
    {
      navigation.map((node) =>
        node.kind === "link" ? (
          <li>
            <a aria-current={node.route === currentRoute ? "page" : undefined} href={node.route}>
              {node.title}
            </a>
          </li>
        ) : (
          <li>
            <details class="nav-group" open={groupContainsRoute(node, currentRoute)}>
              <summary>
                {node.title}
                <svg aria-hidden="true" class="nav-group-caret" viewBox="0 0 24 24">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </summary>
              <ul class="document-sublist">
                {node.items.map((item) => (
                  <li>
                    <a aria-current={item.route === currentRoute ? "page" : undefined} href={item.route}>
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ),
      )
    }
  </ul>
</nav>
