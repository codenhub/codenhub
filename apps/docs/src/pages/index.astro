---
import StatusBadge from "@codenhub/app-shell/components/status-badge.astro";
import type { PublicPackageSummary } from "@codenhub/tools/documentation";

import { publicPackages } from "../lib/catalog";
import BaseLayout from "../layouts/base-layout.astro";

const documentedPackages = publicPackages.filter(
  (entry): entry is PublicPackageSummary & { documentationRoute: string } => entry.documentationRoute !== undefined,
);

function toSearchHaystack(entry: PublicPackageSummary): string {
  return `${entry.label} ${entry.name} ${entry.description ?? ""}`.toLowerCase();
}
---

<BaseLayout description="Every documented package in the CodenHub monorepo." title="Packages">
  <main aria-labelledby="package-catalog-title" class="section-content wide catalog" id="main-content">
    <div class="packages-toolbar">
      <div>
        <h1 id="package-catalog-title">Packages</h1>
      </div>
      <div class="packages-toolbar-controls">
        <div class="input-group package-search">
          <i aria-hidden="true" class="ic-lucide-search"></i>
          <input aria-label="Search packages" id="package-search" placeholder="Search packages…" type="search" />
        </div>
        <button
          aria-label="Sort by name, ascending"
          aria-pressed="false"
          class="package-sort"
          data-sort-direction="asc"
          id="package-sort"
          type="button"
        >
          <i aria-hidden="true" class="ic-lucide-arrow-up-narrow-wide" data-sort-icon="asc"></i>
          <i aria-hidden="true" class="ic-lucide-arrow-down-wide-narrow" data-sort-icon="desc" hidden></i>
          <span data-sort-label>A–Z</span>
        </button>
      </div>
    </div>

    <div class="auto-grid package-grid" id="package-grid" role="list">
      {
        documentedPackages.map((entry) => (
          <a
            class="package-card"
            data-label={entry.label}
            data-search={toSearchHaystack(entry)}
            href={entry.documentationRoute}
            role="listitem"
          >
            <div class="package-card-heading">
              <h2>{entry.label}</h2>
              {entry.status !== undefined && <StatusBadge status={entry.status} />}
            </div>
            <p>{entry.description ?? "Package documentation and reference."}</p>
            <i aria-hidden="true" class="ic-lucide-arrow-right package-card-arrow" />
          </a>
        ))
      }
    </div>
    <p class="packages-empty" data-empty-filtered hidden>No packages match your search.</p>
  </main>
</BaseLayout>

<script>
  import { initPackageGrid } from "@codenhub/app-shell/package-grid";

  initPackageGrid();
</script>
