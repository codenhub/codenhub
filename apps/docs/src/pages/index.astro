---
import type { PublicPackageSummary } from "@codenhub/tools/documentation";

import StatusBadge from "../components/status-badge.astro";
import { publicPackages } from "../lib/catalog";
import BaseLayout from "../layouts/base-layout.astro";

const documentedPackages = publicPackages.filter(
  (entry): entry is PublicPackageSummary & { documentationRoute: string } => entry.documentationRoute !== undefined,
);

function toSearchHaystack(entry: PublicPackageSummary): string {
  return `${entry.label} ${entry.name} ${entry.description ?? ""}`.toLowerCase();
}
---

<BaseLayout description="Every documented package in the CodenHub monorepo." title="Packages">
  <main aria-labelledby="package-catalog-title" class="section-content wide catalog" id="main-content">
    <div class="packages-toolbar">
      <div>
        <h1 id="package-catalog-title">Packages</h1>
      </div>
      <div class="packages-toolbar-controls">
        <div class="input-group package-search">
          <i aria-hidden="true" class="ic-lucide-search"></i>
          <input aria-label="Search packages" id="package-search" placeholder="Search packages…" type="search" />
        </div>
        <button
          aria-label="Sort by name, ascending"
          aria-pressed="false"
          class="package-sort"
          data-sort-direction="asc"
          id="package-sort"
          type="button"
        >
          <i aria-hidden="true" class="ic-lucide-arrow-up-narrow-wide" data-sort-icon="asc"></i>
          <i aria-hidden="true" class="ic-lucide-arrow-down-wide-narrow" data-sort-icon="desc" hidden></i>
          <span data-sort-label>A–Z</span>
        </button>
      </div>
    </div>

    <div class="auto-grid package-grid" id="package-grid" role="list">
      {
        documentedPackages.map((entry) => (
          <a
            class="package-card"
            data-label={entry.label}
            data-search={toSearchHaystack(entry)}
            href={entry.documentationRoute}
            role="listitem"
          >
            <div class="package-card-heading">
              <h2>{entry.label}</h2>
              {entry.status !== undefined && <StatusBadge status={entry.status} />}
            </div>
            <p>{entry.description ?? "Package documentation and reference."}</p>
            <i aria-hidden="true" class="ic-lucide-arrow-right package-card-arrow" />
          </a>
        ))
      }
    </div>
    <p class="packages-empty" data-empty-filtered hidden>No packages match your search.</p>
  </main>
</BaseLayout>

<script>
  const searchInput = document.getElementById("package-search");
  const sortButton = document.getElementById("package-sort");
  const sortLabel = sortButton?.querySelector("[data-sort-label]");
  const grid = document.getElementById("package-grid");
  const emptyMessage = document.querySelector("[data-empty-filtered]");
  const cards = grid
    ? Array.from(grid.children).filter((child): child is HTMLElement => child instanceof HTMLElement)
    : [];

  function applyFilter() {
    if (!(searchInput instanceof HTMLInputElement)) {
      return;
    }

    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;
    for (const card of cards) {
      const matches = query === "" || (card.dataset.search ?? "").includes(query);
      card.hidden = !matches;
      if (matches) {
        visibleCount += 1;
      }
    }

    if (emptyMessage instanceof HTMLElement) {
      emptyMessage.hidden = visibleCount !== 0;
    }
  }

  function applySort() {
    if (!(sortButton instanceof HTMLElement) || grid === null) {
      return;
    }

    const direction = sortButton.dataset.sortDirection === "desc" ? -1 : 1;
    const sorted = [...cards].sort(
      (left, right) => direction * (left.dataset.label ?? "").localeCompare(right.dataset.label ?? ""),
    );
    for (const card of sorted) {
      grid.appendChild(card);
    }
  }

  function toggleSortDirection() {
    if (!(sortButton instanceof HTMLElement)) {
      return;
    }

    const nextDirection = sortButton.dataset.sortDirection === "desc" ? "asc" : "desc";
    sortButton.dataset.sortDirection = nextDirection;
    sortButton.setAttribute("aria-pressed", String(nextDirection === "desc"));
    sortButton.setAttribute(
      "aria-label",
      nextDirection === "desc" ? "Sort by name, descending" : "Sort by name, ascending",
    );
    if (sortLabel instanceof HTMLElement) {
      sortLabel.textContent = nextDirection === "desc" ? "Z–A" : "A–Z";
    }

    for (const icon of sortButton.querySelectorAll<HTMLElement>("[data-sort-icon]")) {
      icon.hidden = icon.dataset.sortIcon !== nextDirection;
    }

    applySort();
  }

  searchInput?.addEventListener("input", applyFilter);
  sortButton?.addEventListener("click", toggleSortDirection);
</script>
