---
import BaseLayout from "../layouts/base-layout.astro";
import { publicPackages } from "../lib/catalog";
import { siteConfig } from "../site-config";

const layers = [
  {
    description:
      "State, validation, routing, keyboard input, errors, localization, themes, and notifications for browser apps.",
    title: "Application primitives",
  },
  {
    description: "Design tokens, composable styles, native web components, and the shared UI foundations built on them.",
    title: "Interface systems",
  },
  {
    description: "Vite build plugins, Tauri integrations, repository tooling, and reusable agent skills.",
    title: "Tooling and platform",
  },
];

const documentedCount = publicPackages.filter(
  (packageEntry) => packageEntry.documentationRoute !== undefined,
).length;
---

<BaseLayout>
  <main class="section-content wide px-(--layout-gutter)" id="main-content">
    <section class="landing-hero">
      <h1>Shared packages, apps, and project standards.</h1>
      <p class="landing-lede">
        Built for and by <a href="https://coden.agency">coden.agency</a>. A common
        foundation for TypeScript, browser, UI, Vite, and Tauri projects.
      </p>
      <div class="landing-actions">
        <a class="btn primary" href="/packages/">Browse packages</a>
        <a class="btn out" href={siteConfig.githubUrl}>View on GitHub</a>
      </div>
      <p class="landing-meta">
        {documentedCount} documented {documentedCount === 1 ? "package" : "packages"}
      </p>
    </section>

    <section aria-labelledby="toolkit-title" class="landing-toolkit">
      <h2 id="toolkit-title">What lives here</h2>
      <div class="layer-grid">
        {
          layers.map((layer) => (
            <article>
              <h3>{layer.title}</h3>
              <p>{layer.description}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="site-footer-content section-content wide">
      <p>&copy; 2026 CodenHub</p>
      <p>Built by <a href="https://coden.agency/">coden</a>.</p>
    </div>
  </footer>
</BaseLayout>
