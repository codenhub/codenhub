---
import ShellLayout from "@codenhub/app-shell/layouts/base-layout.astro";

import { siteConfig } from "../site-config";
import "../styles/global.css";

interface Props {
  description?: string;
  title?: string;
}

const { description, title } = Astro.props;
---

<ShellLayout description={description} siteConfig={siteConfig} title={title}>
  <slot />
</ShellLayout>
