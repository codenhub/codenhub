---
import ShellLayout from "@codenhub/app-shell/layouts/base-layout.astro";

import { siteConfig } from "../site-config";
import "../styles/global.css";

interface Props {
  description?: string;
  title?: string;
}

const { description, title } = Astro.props;
---

<ShellLayout description={description} siteConfig={siteConfig} title={title}>
  <a
    aria-label="CodenHub documentation"
    class="shell-action"
    href={siteConfig.docsUrl}
    rel="noopener noreferrer"
    slot="actions"
    target="_blank"
  >
    <i aria-hidden="true" class="ic-lucide-book-open shell-action-icon"></i>
  </a>
  <slot />
</ShellLayout>
