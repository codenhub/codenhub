---
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout description="The requested demo could not be found." title="Page not found">
  <main class="site-main" id="main-content">
    <div class="shell-content stack">
      <h1>Page not found</h1>
      <p>
        This page moved or never existed. A package's demo is only mounted here once it ships one, so a saved link can
        outlive the page it pointed at.
      </p>
      <p><a class="btn primary" href="/">Go home</a></p>
    </div>
  </main>
</BaseLayout>
