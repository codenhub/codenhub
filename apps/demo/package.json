{
  "name": "@codenhub/demo",
  "version": "0.0.1",
  "private": true,
  "description": "Deployed app aggregating every package's demo/ output into one surface.",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "preview": "wrangler dev",
    "preview:deploy": "wrangler versions upload",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "devDependencies": {
    "@codenhub/icons-demo": "workspace:*",
    "@codenhub/styles": "workspace:*",
    "@types/node": "catalog:",
    "astro": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
