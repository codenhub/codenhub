{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // project:start
  // Tailwind class strings read in a stable order.
  "sortTailwindcss": true,
  // project:end
  "bracketSpacing": true,
  "htmlWhitespaceSensitivity": "ignore",
  "ignorePatterns": [
    // project:start
    // Committed paths to leave unformatted. oxfmt already skips what .gitignore and .prettierignore list.
    // project:end
    "**/*.md"
  ],
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "sortImports": true,
  "sortPackageJson": true,
  "trailingComma": "all"
}
